<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- GBK/CP936 code page for real robocopy log fixtures -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PCMig.Core\PCMig.Core.csproj" />
  </ItemGroup>

  <!--
    ══════════════════════════════════════════════════════════════════════════
    A.5 行为级回归测试的「源码链入」（不是复制、不是桩实现）
    ══════════════════════════════════════════════════════════════════════════
    背景：A.5 新增的 Presentation 逻辑（三态目录树 / 精确选择同步 / MT 线程数恢复 /
    CompletedWithErrors 百分比 / Job 切换复位）位于 src\PCMig.WinUI（WinUI 3 应用项目）。
    测试项目不能 project-reference 它（UseWinUI + net8.0-windows + 会与构建进程抢锁），
    故把**不依赖 XAML 运行时**的 Presentation 源码按文件链入本测试项目编译，
    从而能真正 new 出对象并断言行为（而不是只扫描源码文本）。

    链入判据（逐文件核对过 using 与类型闭包）：
      · 这些文件只 using System.* / PCMig.Core.*，唯一 WinUI 依赖是
        Microsoft.UI.Dispatching.DispatcherQueue（由 TestOnlyDispatcherQueueShim.cs 提供替身，
        该替身恒返回 null = 产品源码里"当前线程无 UI 队列"的真实分支）；
      · 闭包内的其它 Presentation 类型（ObservableObject / ShareItem / PageReadiness /
        DirNode / FileRow）一并链入，无需再引入任何 WinUI 程序集。

    ★ 纪律：不得把 src\PCMig.WinUI 里**依赖 XAML 运行时**的文件（Views\*.xaml.cs、
      Converters、MotionDirector 等）加进这个列表；也不得为了让测试变绿去改 src\ 下任何
      产品代码。若某个链入文件将来引入了 WinUI 运行时类型，本测试项目会编译失败 ——
      那是**必须被看见的信号**，正确做法是把该逻辑下沉为不依赖 UI 的类型，而不是加引用糊过去。
  -->
  <ItemGroup Label="A5LinkedPresentationSources">
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\ObservableObject.cs" Link="LinkedPresentation\ObservableObject.cs" />
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\ShareItem.cs" Link="LinkedPresentation\ShareItem.cs" />
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\DirTreeModels.cs" Link="LinkedPresentation\DirTreeModels.cs" />
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\DirectoryTreeViewModel.cs" Link="LinkedPresentation\DirectoryTreeViewModel.cs" />
    <!-- ★ 2026-10-08（真机问题 4）★ 底栏「源连接」三态枚举：纯枚举、零 WinUI 依赖 ⇒ 与 VM 一并链入
         （ConnectionViewModel 的 SourceState / UpdateSourceState 用到它；不链入会 CS0246）。 -->
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\SourceConnectionState.cs" Link="LinkedPresentation\SourceConnectionState.cs" />
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\ConnectionViewModel.cs" Link="LinkedPresentation\ConnectionViewModel.cs" />
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\PageReadiness.cs" Link="LinkedPresentation\PageReadiness.cs" />
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\MigrationSessionViewModel.cs" Link="LinkedPresentation\MigrationSessionViewModel.cs" />
    <!-- ★ FIX BATCH 6（§9）★ 状态消息的语义通道枚举：纯枚举、零 WinUI 依赖 ⇒ 与 VM 一并链入
         （VM 的 SetXxx 通道写入者用到它；不链入会 CS0246）。 -->
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\StatusChannel.cs" Link="LinkedPresentation\StatusChannel.cs" />
    <!-- A.5（P1-5 / D1 / D2）：UI 节流的**纯逻辑**缓冲（只 using System.*）。
         ★ 不得把持 DispatcherQueueTimer 的 UiFlushPump.cs 加进来 ★ —— 本测试项目没有
         DispatcherQueueTimer 替身，链入它会编译失败；那正是"薄泵与纯逻辑分层"的原因。 -->
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\UiBatchBuffer.cs" Link="LinkedPresentation\UiBatchBuffer.cs" />
    <!-- A.5（P1-5）诊断出口：只 using System.IO，零 WinUI 依赖 ⇒ 可链入（VM 会调用它）。 -->
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\UiFlushTrace.cs" Link="LinkedPresentation\UiFlushTrace.cs" />
    <!-- ★ Round-2 2026-10-05（§3.2 / §3.3）★ 进度**呈现**时间线：纯 System.* 逻辑（无 WinUI 类型），
         VM 持有并驱动它、UI 读它取视觉百分比 ⇒ 必须链入，否则 VM 编译失败（CS0246）。
         行为级断言见 ProgressPresentationCoordinatorTests。 -->
    <Compile Include="..\..\src\PCMig.WinUI\Presentation\ProgressPresentationCoordinator.cs" Link="LinkedPresentation\ProgressPresentationCoordinator.cs" />
  </ItemGroup>

  <!--
    ══════════════════════════════════════════════════════════════════════════
    ★ Round-3 PHASE D（执行书 §11 / §26 判据 ⑨）★ Immersive Progress 的**纯逻辑**链入
    ══════════════════════════════════════════════════════════════════════════
    为什么要链入：真机 timeline.csv 曾出现两类越界（0% 时仍有 14 枚粒子存活；
    progressWidth=26.233 时 particleMinX=-1.163）——这类缺陷必须在**数字层面**被锁死，
    而不是靠人看 CSV 事后发现。粒子池与参数表都只 using System.*，
    故可被 net8.0 的测试项目真实 new 出来断言（见 ImmersiveProgressParticleBoundsTests）。
    ★ 纪律：本分组只许链入**纯 System.*** 文件。ImmersiveProgressPalette 带
      Windows.UI.Color（WinRT），因此它被刻意放在 ImmersiveTransferProgressRenderer.cs、
      不放在参数表里；若将来有人把 WinRT 类型放回参数表，本测试项目会编译失败 ——
      那是必须被看见的信号，正确做法是继续分层，而不是加引用糊过去。
  -->
  <ItemGroup Label="Round3ImmersivePureLogicSources">
    <Compile Include="..\..\src\PCMig.WinUI\Controls\ImmersiveProgress\ImmersiveProgressParameters.cs" Link="LinkedImmersive\ImmersiveProgressParameters.cs" />
    <Compile Include="..\..\src\PCMig.WinUI\Controls\ImmersiveProgress\ImmersiveProgressParticle.cs" Link="LinkedImmersive\ImmersiveProgressParticle.cs" />
    <!-- 动画状态（Band 相位 / 粒子池 / Ripple 池 / Halo）：同样零 using、纯 System.* ⇒
         可对「判据 ⑦ 单调逼近 + 连续减速」「⑧ Ripple 上限」「⑩⑪ Paused/Failed 停止活动」
         「⑫ Head 静止而 Band 继续」做真实数字断言（ImmersiveProgressAnimationStateTests）。 -->
    <Compile Include="..\..\src\PCMig.WinUI\Controls\ImmersiveProgress\ImmersiveProgressAnimationState.cs" Link="LinkedImmersive\ImmersiveProgressAnimationState.cs" />
  </ItemGroup>

</Project>
