<UserControl
    x:Class="PCMig.WinUI.Views.ChangelogPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 这里不再声明 EntranceThemeTransition：Shell 的 PreparePanelEntrance 会 Transitions.Clear() 后
       重新挂一次（带 MotionState 防重入判定，且尊重系统动画偏好）。留着声明式转场只会被运行时覆盖，
       属死代码。§29 的 Fade + 轻微 Slide 仍由运行时提供。 -->
  <!-- A42（20260928）：历史更新面板同属**高可读性工具面板**，与 Developer Visual Tuning 共用同一套
       Utility 固定材质（用户第 24/25/26 节）：
         · Base Material = PCMigUtilityPanelMaterial80（= DVT「Card 层 80 档」解析值 0xDF，独立 Brush 实例，
           不在 DeveloperVisualTuning 的 Layers/Surfaces 表里 ⇒ 拖 Global/Card/Workspace 滑块时本面板不变）；
         · Lighting 仍走全应用统一光源 PCMigSurfaceRimLightBrush（材质与光照是两套独立概念）。
       几何（Width 440 / MaxHeight 720 / CornerRadius 18 / Padding 16）一律未动。 -->
  <Border Width="440" MaxHeight="720" HorizontalAlignment="Right" VerticalAlignment="Top"
          Background="{StaticResource PCMigUtilityPanelMaterial80}" BorderBrush="{StaticResource PCMigDAELBrushQuiet}"
          BorderThickness="1" CornerRadius="18" Padding="16" Translation="0,0,24">
    <Grid RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="2">
          <TextBlock Style="{StaticResource PCMigTextListItemTitle}" Text="更新日志" Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock x:Name="CaptionText" Style="{StaticResource PCMigTextListItemMeta}" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Click="Close_Click" Background="Transparent" BorderThickness="0" Padding="6" ToolTipService.ToolTip="关闭更新日志">
          <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Button>
      </Grid>
      <Grid Grid.Row="1" ColumnSpacing="12" MinHeight="260">
        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource PCMigUtilityPanelInset80}" CornerRadius="12" Padding="6">
          <!-- A43：列表自带滚动条同样是覆盖式，给列表项预留右侧内边距 -->
          <ListView x:Name="VersionList" Padding="0,0,8,0" SelectionChanged="VersionList_SelectionChanged" SelectionMode="Single"
                    Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Padding="6" Spacing="1">
                  <TextBlock Text="{Binding Version}" Style="{StaticResource PCMigTextListItemTitle}" Foreground="{StaticResource AccentBrush}"/>
                  <TextBlock Text="{Binding Date}" Style="{StaticResource PCMigTextListItemMeta}" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource PCMigUtilityPanelInset80}" CornerRadius="12" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" Margin="0,0,10,0">
              <TextBlock x:Name="EntryTitleText" Style="{StaticResource PCMigTextActionButton}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
              <TextBlock x:Name="EntryDateText" Style="{StaticResource PCMigTextListItemMeta}" Foreground="{StaticResource TextMutedBrush}"/>
              <TextBlock x:Name="EntryBodyText" Style="{StaticResource PCMigTextListItemBody}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      <Grid Grid.Row="2" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="内置版本历史 · 唯一来源：更新日志" Style="{StaticResource PCMigTextListItemMeta}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
        <Button Grid.Column="1" Style="{StaticResource PCMigSecondaryButton}" Click="Previous_Click" Padding="10,6"><TextBlock Text="上一版" Style="{StaticResource PCMigTextListItemMeta}"/></Button>
        <Button Grid.Column="2" Style="{StaticResource PCMigSecondaryButton}" Click="Next_Click" Padding="10,6"><TextBlock Text="下一版" Style="{StaticResource PCMigTextListItemMeta}"/></Button>
      </Grid>
    </Grid>
  </Border>
</UserControl>
