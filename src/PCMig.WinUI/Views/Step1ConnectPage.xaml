<UserControl
    x:Class="PCMig.WinUI.Views.Step1ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 页面入场动画由 Shell 统一播放（方向性，见 Presentation\MotionDirector.cs）。
         这里不再声明 EntranceThemeTransition：声明式转场会与 Shell 的方向性动画叠加。 -->

    <!--
        Step 1 — 连接旧电脑（从 MainWindow.xaml 的 workspace 段落**原样搬入**，markup 未改）。
        页面自己的结构必须自包含：页面标题行 + 连接表单卡 + 可用共享卡 + 底部主行动。
        Shell 负责的工作区外壳（ShellMaterial 边框 / 行定义）由 ContentHost 提供，因此这里不再重复。
        绑定统一指向本页的 Vm（由 MainWindow 在构造时注入唯一实例，不新建第二份状态）。
    -->
    <Grid x:Name="RootGrid" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 可用共享卡：共享列表是动态数据 ⇒ 星号行吃满剩余高度，行内 ListView 自己滚 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
     <StackPanel x:Name="PageTitleStack" Spacing="6"><StackPanel x:Name="PageTitleRow" Orientation="Horizontal" Spacing="12"><Border x:Name="PageBadge" Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentGradientBrush}" BorderBrush="#B8FFFFFF" BorderThickness="1" Translation="0,0,24" Shadow="{StaticResource ElevationHigh}"><Grid><Border CornerRadius="16" Margin="1" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0.25,0" EndPoint="0.25,1"><GradientStop Color="#59FFFFFF" Offset="0"/><GradientStop Color="#14FFFFFF" Offset="0.42"/><GradientStop Color="#00FFFFFF" Offset="0.70"/></LinearGradientBrush></Border.Background></Border><TextBlock Style="{StaticResource PCMigTextStepBadge}" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Grid></Border><TextBlock x:Name="PageTitleText" Style="{StaticResource PCMigTextPageTitle}" Text="连接旧电脑" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="PageSubtitle" Style="{StaticResource PCMigTextPageSubtitle}" Text="填写旧电脑的 IP/电脑名与账号，点击侧按钮建立连接并列出可迁移的共享。"/></StackPanel>
     <Border x:Name="FormCard" Grid.Row="1" Translation="0,0,16" Style="{StaticResource ElevatedSurface}" Padding="12"><Grid x:Name="FormGrid" RowSpacing="8" ColumnSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><!-- 第 4 行：连接/添加共享的可见状态行（缺陷 A-02/A-03；见文件末尾 PMML Gate 注释） --><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HostLabel" Style="{StaticResource PCMigTextFieldLabel}" Grid.Row="0" Grid.Column="0" Text="IP 或电脑名" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/><Grid x:Name="HostInputGrid" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"><TextBox x:Name="HostInput" AutomationProperties.AutomationId="Step1.HostInput" Style="{StaticResource PCMigTextBoxCentered}" Padding="42,8,14,8" PlaceholderText="例如：192.168.1.100 或 DESKTOP-ABCD" Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><FontIcon x:Name="HostInputIcon" Glyph="&#xE7F4;" FontSize="18" Margin="15,0,0,0" Translation="0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}"/></Grid><TextBlock x:Name="UsernameLabel" Style="{StaticResource PCMigTextFieldLabel}" Grid.Row="1" Grid.Column="0" Text="用户名" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/><Grid x:Name="UsernameInputGrid" Grid.Row="1" Grid.Column="1"><TextBox x:Name="UsernameInput" AutomationProperties.AutomationId="Step1.UsernameInput" Style="{StaticResource PCMigTextBoxCentered}" Padding="42,8,14,8" PlaceholderText="请输入用户名" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><FontIcon x:Name="UsernameInputIcon" Glyph="&#xE77B;" FontSize="18" Margin="15,0,0,0" Translation="0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}"/></Grid><TextBlock x:Name="PasswordLabel" Style="{StaticResource PCMigTextFieldLabel}" Grid.Row="1" Grid.Column="2" Text="密码" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/><Grid x:Name="PasswordInputGrid" Grid.Row="1" Grid.Column="3"><PasswordBox x:Name="PasswordInput" AutomationProperties.AutomationId="Step1.PasswordInput" Style="{StaticResource PCMigPasswordBoxCentered}" Padding="42,8,46,8" PlaceholderText="请输入密码"/><FontIcon x:Name="PasswordInputIcon" Glyph="&#xE72E;" FontSize="18" Margin="15,0,0,0" Translation="0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}"/><Button x:Name="PasswordRevealButton" Click="TogglePasswordReveal_Click" Background="Transparent" BorderThickness="0" Padding="6" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="显示密码"><FontIcon Glyph="&#xE7B3;" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}"/></Button></Grid><StackPanel x:Name="BenchmarkPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0" VerticalAlignment="Center"><ToggleSwitch AutomationProperties.AutomationId="Step1.BenchmarkToggle" MinWidth="0" OffContent="" OnContent="" IsOn="{Binding BenchmarkOnConnect, Mode=TwoWay}"/><!-- ★ A7（B1，2026-09-30）★ 必须显式 VerticalAlignment="Center"：横向 StackPanel 的子元素默认 Stretch
     ⇒ TextBlock 的盒子被拉满整行高，而 TextBlock 的文本是**从自己盒子顶部**开始绘制的（控件会内部居中，TextBlock 不会）
     ⇒ 文字视觉中心比左侧 ToggleSwitch 高约 (行高−行高)/2 ≈ 8px，看起来"偏上、像压进上一行"（用户红标注图实证）。
     只改本 TextBlock 自身；**不动** BenchmarkPanel 的 Margin、不动 Grid.Row / RowSpacing / 卡片高度 / 其它控件。 -->
     <TextBlock Style="{StaticResource PCMigTextFormNote}" VerticalAlignment="Center" Text="连接时测速（向旧电脑写读 64MB 测试文件，建立正常速度基准）"/><FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></StackPanel><Button x:Name="ConnectButton" AutomationProperties.AutomationId="Step1.Connect" Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Style="{StaticResource PCMigPrimaryButton}" VerticalAlignment="Stretch" MinWidth="196" IsEnabled="{Binding CanConnect}" Click="Connect_Click"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE71B;" FontSize="15"/><TextBlock Style="{StaticResource PCMigTextActionButton}" Text="连接并列出共享"/><FontIcon Glyph="&#xE76C;" FontSize="13"/></StackPanel></Button><!-- 连接 / 添加共享的可见状态行（缺陷 A-02 / A-03）：文本来自 ConnectionViewModel.Status 的唯一写入者，
             文案里已包含「发生了什么 + 现在该怎么做」。样式复用本卡片既有的 PCMigTextFormNote，不新增 Token / 不内联字号与 Margin。 -->
         <!-- ★ 2026-10-08 真机复验（问题 1 → 返修 R1：口径反转）★ 本行职责收窄为「字段级短校验」★
               改前这里是一个**裸 TextBlock** 直接坐在 FormGrid 第 4 行（Height="Auto"）上：
               `TextWrapping="Wrap"` 只保证换行、**不保证不撑高** —— 一行 Core/Win32/SMB 长异常
               （IPC$/1219/67/1327 那一整段）会把 Auto 行拉到几百 DIP，把整个 Step 1 布局撑坏。
               问题 1 的第一版把失败「摘要 + 建议」放进了这里 —— 那是**相反的方向**，用户 2026-10-08 明确：
                 · 完整用户可读说明必须显示在**左侧 Shell 的「提示」卡**里
                   （OperationalStatus = 发生了什么、UserHint = 下一步怎么做、ErrorSummary = 错误摘要），
                   由 ConnectionViewModel.SetFlowFailure 三通道一次落位；
                 · 本表单区域**只允许**保留字段级校验：主机名不能为空 / 共享名含非法字符 /
                   用户名与密码相关的字段级提示 —— 这类短句（通常 1~2 行）；
                 · 同一套失败文本不得在表单与提示卡两处重复；
                 · Win32 / IPC$ / 67 / 1219 / 1327 等完整原文继续只进日志。
               保留 MaxHeight + Auto 滚动：只为防御**异常长**的字段级文本（例如超长共享名）仍不越界。
               为什么把 Grid.Row/Column 同时写在 ScrollViewer 与内层 TextBlock 上：前者是真实布局位置，
               后者保留既有契约断言（状态文本仍带 AutomationId=Step1.StatusText 与同一套附加属性）。 -->
          <ScrollViewer x:Name="StatusScroll" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                        MaxHeight="88" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                        HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="StatusStack" Spacing="4">
              <TextBlock x:Name="StatusLineText" AutomationProperties.AutomationId="Step1.StatusText" Style="{StaticResource PCMigTextFormNote}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" TextWrapping="Wrap" Text="{Binding InlineNote, Mode=OneWay}"/>
              <TextBlock x:Name="StatusAdviceText" AutomationProperties.AutomationId="Step1.StatusAdvice" Style="{StaticResource PCMigTextFormNote}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding InlineAdvice, Mode=OneWay}"/>
            </StackPanel>
          </ScrollViewer></Grid></Border>
     <Border x:Name="SharesCard" Grid.Row="2" Translation="0,0,10" Style="{StaticResource SecondarySurface}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid x:Name="SharesHeaderGrid" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8D5;" FontSize="22" Foreground="{StaticResource AccentBrush}"/><Grid VerticalAlignment="Center" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="可用共享" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="勾选即选中整盘；展开左侧目录可精确到文件夹/文件。" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></StackPanel><!-- ★ A.5（第 7 条 · 产品诚实性）★ 搜索框置为 IsEnabled="False"：改前可输入但完全无效果（筛选未接入）。
                 本阶段不实现筛选逻辑，只如实标注"暂未启用"；标注落在**占位符**上
                 （禁用控件的 ToolTip 悬停默认不弹，不能只靠 tooltip 传达）。 --><TextBox x:Name="SearchBox" Grid.Column="1" Width="230" VerticalAlignment="Center" Style="{StaticResource PCMigTextBoxCentered}" Padding="40,8,12,8" IsEnabled="False" PlaceholderText="搜索共享名称（暂未启用）" ToolTipService.ToolTip="搜索/筛选暂未启用（筛选逻辑尚未接入）：请直接在下面共享列表里勾选。"/><FontIcon Grid.Column="1" Glyph="&#xE721;" FontSize="15" Margin="14,0,0,0" Translation="0,-0.5,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}"/><Button Grid.Column="2" Style="{StaticResource PCMigSecondaryButton}" VerticalAlignment="Center"><Button.Flyout><Flyout Placement="BottomEdgeAlignedRight" AreOpenCloseAnimationsEnabled="True"><StackPanel Spacing="10" Width="262"><TextBlock Style="{StaticResource PCMigTextActionButton}" Text="手动添加共享"/><TextBox AutomationProperties.AutomationId="Step1.ManualShareName" Style="{StaticResource PCMigTextBoxCentered}" Header="手动共享名" PlaceholderText="d、D$ 或 Users" Text="{Binding ManualShareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Content="添加共享" Style="{StaticResource PCMigPrimaryButton}" HorizontalAlignment="Right" AutomationProperties.AutomationId="Step1.AddShare" Click="AddShare_Click"/></StackPanel></Flyout></Button.Flyout><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Style="{StaticResource PCMigTextActionButton}" Text="添加共享"/></StackPanel></Button></Grid><Grid Grid.Row="1" Margin="0,14,0,0"><StackPanel x:Name="EmptySharesHint" AutomationProperties.AutomationId="Step1.EmptySharesHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><Grid HorizontalAlignment="Center" Width="116" Height="88">
        <!-- V9 空状态插画（全矢量）：背后自然衰减光晕（无矩形边界）→ 轮廓外环境点 → 文件夹后背层（带签页，软投影）
             → 前置倾斜半透明磨砂面板（对角边缘高光） → 浮动 + 徽章（光晕 + elevation）
             尺寸按参考图比例（约 88 DIP 高）设计，避免把 EmptySharesHint 撑高导致回归裁切。 -->
        <Ellipse Width="300" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-16,0,0"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#B4D8F4FF"/><GradientStop Color="#86E4F4FF" Offset="0.28"/><GradientStop Color="#44E4F4FF" Offset="0.58"/><GradientStop Color="#14D8F4FF" Offset="0.8"/><GradientStop Color="#00D8F4FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
        <Ellipse Width="9" Height="9" Fill="#9CC8FF" Opacity="0.9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-5,0,0"/>
        <Ellipse Width="7" Height="7" Fill="#C4C0FF" Opacity="0.95" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,14,0"/>
        <Ellipse Width="6" Height="6" Fill="#FFC8DA" Opacity="0.8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
        <Ellipse Width="5" Height="5" Fill="#8CDDF0" Opacity="0.85" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,23"/>
        <Path Translation="0,0,8" Shadow="{StaticResource ElevationMedium}" Data="M10.6,1.8 L38.7,1.8 Q44,1.8 47.5,7 L52.8,14 L105.6,14 Q110.9,14 110.9,19.4 L110.9,77.4 Q110.9,82.7 105.6,82.7 L10.6,82.7 Q5.3,82.7 5.3,77.4 L5.3,7 Q5.3,1.8 10.6,1.8 Z"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1"><GradientStop Color="#D8ECFFFF"/><GradientStop Color="#F5E6F0FF" Offset="0.6"/><GradientStop Color="#FAEDE6FF" Offset="1"/></LinearGradientBrush></Path.Fill></Path>
        <Border Width="98" Height="62" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,5" Translation="0,0,14" Shadow="{StaticResource ElevationHigh}" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><RotateTransform Angle="-8"/></Border.RenderTransform>
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.55,1"><GradientStop Color="#B8FFFFFF"/><GradientStop Color="#8AFFFFFF" Offset="0.6"/><GradientStop Color="#5CFFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
          <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFFFF"/><GradientStop Color="#8AFFFFFF" Offset="0.45"/><GradientStop Color="#3CFFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
          <Border.BorderThickness>1</Border.BorderThickness>
        </Border>
        <Ellipse Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,4"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#669CC8FF"/><GradientStop Color="#009CC8FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentGradientBrush}" BorderBrush="#B8FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,4" Translation="0,0,26" Shadow="{StaticResource ElevationHigh}"><FontIcon Glyph="&#xE710;" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid><TextBlock Style="{StaticResource PCMigTextEmptyStateTitle}" Text="还没有共享列表。" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource PCMigTextEmptyStateBody}" Text="在上面填写 IP/账号后点击“连接并列出共享”；" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource PCMigTextEmptyStateBody}" Text="对方列不出共享时，可用右侧“+ 添加共享”手动输入共享名。" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/></StackPanel><ListView AutomationProperties.AutomationId="Step1.ShareList" ItemsSource="{Binding Shares}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,2" CornerRadius="10" Background="{StaticResource ListItemSurfaceBrush}" BorderBrush="{StaticResource BorderNormalBrush}" BorderThickness="1"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource PCMigTextListItemTitle}" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Style="{StaticResource PCMigTextListItemBody}" Text="{Binding UncPath}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Style="{StaticResource PCMigTextListItemMeta}" Text="{Binding Remark}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Style="{StaticResource PCMigTextListItemMeta}" Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Grid></Border>
     <!-- A51 去重（用户截图发现的 bug）：这里原来还有一个**页面自带的「下一步…」主行动按钮**，
           它与 Shell 层统一 Navigation Footer（MainWindow.xaml）渲染出的同名按钮上下叠着、重复两遍。
           设计口径是「导航 Footer 只在 Shell 一份，四个页面都不再各自放按钮」，故按用户指令**删除**该按钮，
           并连同它唯一的 Click 处理器（Step1ConnectPage.xaml.cs 里的那个方法）一并删除；
           该行 RowDefinition 也随之删除，避免留下 12 DIP 的空行间距。
           注：本注释刻意不写出被删按钮的处理器名与按钮文案 —— 契约测试
           WinUiStep1ContractTests 用纯子串断言这两者在页面 XAML 中已不存在。 -->
    <!--
        ============================ PMML Compliance Gate ============================
        本轮改动：FormGrid 增加第 4 行 + 新增只读状态文本 StatusLineText（缺陷 A-02 / A-03 的可见反馈面）。
        DAM                 : N/A（未新增/未改动任何材质画刷，未引入 Blur）
        LMDS                : PASS（状态行位于既有 ElevatedSurface 卡片内部，不新增 Surface、不新增层级）
        DSL-45              : N/A（无边框/高光/阴影改动，不改变光源方向）
        ESR                 : N/A（无浮雕四件套改动）
        Motion Family       : N/A（纯文本呈现，无进入/退出/Hover 动效；动画与业务状态无关，符合 R8）
        TAOP                : N/A（无新增 Popup / Flyout；既有 Flyout 的 Placement 归属未改）
        Typography          : PASS（复用 Themes\Typography.xaml 既有 Style PCMigTextFormNote:51，未内联 FontSize/Margin）
        Foreground Sharpness: PASS（文本为 L2 卡片前景，位于锐利层，未进入 Blur，符合 R4 / R13）
        Light-Dark          : Known Gap G-01（全仓零 Dark 覆盖，本次同样只按浅色定义，不为 Freeze 强行补齐）
        Accessibility       : Known Gap G-02（XAML 侧无 Reduced Motion 闸门）；状态文本可被 UIA 读取
                              （AutomationId=Step1.StatusText），文案自带动词与下一步，不依赖颜色传达严重度
        Legacy Deviation Introduced: NO（未新增 Token / 未改动任何既有值，符合 R14）
        合规声明：本改动不改变任何既有 Surface 的值（圆角/尺寸/Padding/颜色/阴影/材质/动效），
                  仅新增一个使用既有 Style 的文本元素与一行 Auto 行定义。
        ==============================================================================
    -->
    </Grid>
</UserControl>