<UserControl
    x:Class="PCMig.WinUI.Views.ShellHintCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        侧栏底部提示卡（从 MainWindow.xaml 原样搬入，markup 未改）。
        属于 **Shell 层**：四个 Step 都显示同一张（Shell/Header/Sidebar/Footer 不重复创建）。
        内容全部是静态展示（就绪 / 暂无报错 / 署名），不承载业务状态——
        将来的真实健康度若接入，应在 Presentation 层加薄状态，而不是在四个页面各写一份。
    -->
    <Border Style="{StaticResource SecondarySurface}" Padding="14,16" Translation="0,0,8" Margin="0,12,0,0">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Width="20" Height="20" CornerRadius="10" Background="#2416A34A" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE82F;" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Style="{StaticResource PCMigTextHintTitle}" Text="提示" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource PCMigTextHintBody}" Text="就绪"/>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PCMigTextHintStatus}" Text="暂无报错" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Height="1" Background="{StaticResource InsetBorderBrush}" Margin="0,2,0,2"/>
            <TextBlock Style="{StaticResource PCMigTextHintCredit}" Text="由 郑子轩 个人制作"/>
        </StackPanel>
    </Border>
</UserControl>