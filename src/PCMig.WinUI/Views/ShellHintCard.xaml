<UserControl
    x:Class="PCMig.WinUI.Views.ShellHintCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        侧栏底部提示卡（Shell 层组件，四个 Step 共用同一份外观）。
        属于 **Shell 层**：四个 Step 都显示同一张（Shell/Header/Sidebar/Footer 不重复创建）。

        ★ FIX BATCH 6（指令 §9）：状态消息路由 ★
        改前：卡片里是两行**冻结文案**（Text="就绪" / Text="暂无报错"），
              而真实状态句全部挤在右侧执行卡的一根 StatusMessage 上（长句把执行卡无限撑高）。
        改后：本卡只读 ViewModel 的**语义通道**（OperationalStatus / UserHint / ErrorSummary /
              CurrentObjectStatus），不再有硬编码状态；空通道才折叠对应行，
              全部为空时第一行显示「就绪」、状态行显示「暂无报错」。
        纪律：本卡**不拼业务状态**（禁止在 View 里根据 Phase/Percent 自己造句）——
              文案的唯一来源是 MigrationSessionViewModel 的通道属性。

        ★ Round-2 2026-10-05（用户指令 §4）：固定尺寸 ★ → ★ 2026-10-08（真机问题 3）：自适应展开 ★
        历史：Round-2 曾把外层高度锁死为固定 176 DIP，代价是四个通道全部用
              MaxLines + CharacterEllipsis 丢弃真实业务信息（真机表现：一长就变成"……"）。
        现行口径（用户 2026-10-08 指令，逐条对应）：
          · Q1 默认态：内容少时仍是 PCMigHintCardHeight = 176 DIP 的视觉尺寸；
                高度**只在明确的内容档位变化时**改写一次，绝不"多一行就小幅变高"。
                XAML 里的 Height="{StaticResource PCMigHintCardHeight}" 现在表达
                **下界（默认高）**：运行时由 ShellHintCard 按
                Clamp(正文自然所需高, 176, 侧栏允许最大高) 一次性改写（唯一写入点）。
          · Q2 内容变多：**一次确定目标高度** ⇒ 布局直接把 Border 设到目标高；
                视觉上的"自下而上平滑展开"由 Composition 的 Clip 揭示完成，
                **没有**任何逐帧 Layout Height 动画 / Timer 累加高度（详见 ShellHintCard.xaml.cs）。
          · Q3 方向：底边不动、**顶部向上长**——揭示遮罩固定露出卡片**底部**，
                随着高度到位，被遮住的顶部区域逐帧让位（视觉上就是顶边向上推）。
          · Q4 上界：ShellHintCard.SetAvailableHeight 收到的是
                「侧栏高 − StepNav(即 Step4 所在控件)高 − 标准段间距(=本卡 Margin.Top 12)」，
                这就是 Step4 与底栏之下的安全边界；卡片高度永不越过它，
                因此绝不覆盖 Step4 / 底栏 / 其它 Shell UI（见 MainWindow.UpdateHintCardHeight）。
          · Q5 达到上界仍放不下：内容区 VerticalScrollBarVisibility="Auto"，
                用户可用滚轮 / 触摸板 / 拖动滚动条查看完整内容；
                **不再有 MaxLines / CharacterEllipsis** —— 省略号不再是信息丢弃手段。
          · Q6：HintOperationalText / HintObjectText / HintUserText / HintErrorText
                四个通道都完整保留文本，靠"先长高（到上界）→ 再滚动"而不是"截断"。
    -->
    <Border x:Name="HintCardSurface" Style="{StaticResource SecondarySurface}" Padding="14,16" Translation="0,0,8" Margin="0,12,0,0"
             Height="{StaticResource PCMigHintCardHeight}">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <!-- Row0：标题（固定行，永不因内容变化） -->
                <RowDefinition Height="Auto"/>
                <!-- Row1：内容视口 —— 本卡**唯一**可变区；装不下时只在它内部滚动 -->
                <RowDefinition Height="*"/>
                <!-- Row2：状态行 -->
                <RowDefinition Height="Auto"/>
                <!-- Row3：分隔线 -->
                <RowDefinition Height="Auto"/>
                <!-- Row4：署名 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="7">
                <Border Width="20" Height="20" CornerRadius="10" Background="#2416A34A" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE82F;" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Style="{StaticResource PCMigTextHintTitle}" Text="提示" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row1：四个语义通道（Q6：全部完整可查看）。
                 滚动条 = Auto（Q5）：装得下时不出现任何可见滚动条，只有"长到上界仍放不下"时才出现，
                 供鼠标滚轮 / 触摸板 / 拖动查看剩余内容。
                 四个 TextBlock **不再有** MaxLines / TextTrimming —— 只靠 TextWrapping="Wrap" 自然换行，
                 真实高度由 ShellHintCard 量出来并驱动外层一次到位的目标高度。
                 内层 Grid 用 VerticalAlignment="Bottom"：内容比视口矮时贴着**底部**排，
                 于是尺寸只在上方增加，视觉与"底边固定、顶部向上长"（Q3）一致。 -->
            <ScrollViewer Grid.Row="1" x:Name="HintScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          IsTabStop="False">
                <Grid VerticalAlignment="Bottom">
                    <StackPanel Spacing="8" x:Name="HintContentPanel">
                        <!-- 运行/流程状态（OperationalStatus；为空时显示"就绪"） -->
                        <TextBlock Style="{StaticResource PCMigTextHintBody}" TextWrapping="Wrap"
                                   x:Name="HintOperationalText" Text="就绪"/>

                        <!-- 当前对象（CurrentObjectStatus；引擎真值，为空则折叠） -->
                        <TextBlock Style="{StaticResource PCMigTextHintBody}" TextWrapping="Wrap" Visibility="Collapsed"
                                   x:Name="HintObjectText"/>

                        <!-- 用户操作引导（UserHint；为空则折叠） -->
                        <TextBlock Style="{StaticResource PCMigTextHintBody}" TextWrapping="Wrap" Visibility="Collapsed"
                                   x:Name="HintUserText"/>

                        <!-- 错误摘要（ErrorSummary；为空则折叠） -->
                        <TextBlock Style="{StaticResource PCMigTextHintBody}" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{StaticResource WarningBrush}"
                                   x:Name="HintErrorText"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{StaticResource SuccessBrush}"
                          VerticalAlignment="Center" x:Name="HintStatusIcon"/>
                <TextBlock Style="{StaticResource PCMigTextHintStatus}" Text="暂无报错" VerticalAlignment="Center"
                           x:Name="HintStatusText"/>
            </StackPanel>
            <Border Grid.Row="3" Height="1" Background="{StaticResource InsetBorderBrush}" Margin="0,2,0,2"/>
            <TextBlock Grid.Row="4" Style="{StaticResource PCMigTextHintCredit}">
                <Run Text="由 "/>
                <Hyperlink NavigateUri="https://github.com/AxuanBest/PCMig">
                    <Run Text="AxuanBest"/>
                </Hyperlink>
                <Run Text=" 个人制作"/>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>