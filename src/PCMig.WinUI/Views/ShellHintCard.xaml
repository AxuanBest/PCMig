<UserControl
    x:Class="PCMig.WinUI.Views.ShellHintCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        侧栏底部提示卡（Shell 层组件，四个 Step 共用同一份外观）。
        属于 **Shell 层**：四个 Step 都显示同一张（Shell/Header/Sidebar/Footer 不重复创建）。

        ★ FIX BATCH 6（指令 §9）：状态消息路由 ★
        改前：卡片里是两行**冻结文案**（Text="就绪" / Text="暂无报错"），
              而真实状态句全部挤在右侧执行卡的一根 StatusMessage 上（长句把执行卡无限撑高）。
        改后：本卡只读 ViewModel 的**语义通道**（OperationalStatus / UserHint / ErrorSummary /
              CurrentObjectStatus），不再有硬编码状态；空通道才折叠对应行，
              全部为空时第一行显示「就绪」、状态行显示「暂无报错」。
        纪律：本卡**不拼业务状态**（禁止在 View 里根据 Phase/Percent 自己造句）——
              文案的唯一来源是 MigrationSessionViewModel 的通道属性。

        ★ Round-2 2026-10-05（用户指令 §4）：固定尺寸 ★
        用户视频证据：提示卡在 30 s 处因 OperationalStatus 长句"变得很高"、37.5 s 又缩回。
        用户已明确**接受并选择固定尺寸** —— 所以本卡的高度**不再由内容决定**：
          · 外层 Border 高度 = PCMigHintCardHeight 固定 token（176 DIP），
            正常/宽窗口下恒定；只有物理视口真的更矮时才由
            ShellHintCard.SetAvailableHeight 夹到可用高（"断点换档"）。
          · 内层固定 5 行：Row0 标题 / Row1 内容视口(*) / Row2 状态 / Row3 分隔线 / Row4 署名。
            **只有 Row1 会随内容变化**，溢出只发生在 Row1 内部（滚动条视觉隐藏，滚轮/触摸仍可用）。
          · 每个通道都有 MaxLines + CharacterEllipsis，所以"更多内容"绝不会放大外层卡。
          · 不再有任何 Height 动画、不再监听 SizeChanged 反向驱动高度。
    -->
    <Border x:Name="HintCardSurface" Style="{StaticResource SecondarySurface}" Padding="14,16" Translation="0,0,8" Margin="0,12,0,0"
            Height="{StaticResource PCMigHintCardHeight}">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <!-- Row0：标题（固定行，永不因内容变化） -->
                <RowDefinition Height="Auto"/>
                <!-- Row1：内容视口 —— 本卡**唯一**可变区；溢出只在它内部滚动 -->
                <RowDefinition Height="*"/>
                <!-- Row2：状态行 -->
                <RowDefinition Height="Auto"/>
                <!-- Row3：分隔线 -->
                <RowDefinition Height="Auto"/>
                <!-- Row4：署名 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="7">
                <Border Width="20" Height="20" CornerRadius="10" Background="#2416A34A" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE82F;" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Style="{StaticResource PCMigTextHintTitle}" Text="提示" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row1：四个语义通道。滚动条设为 Hidden（§4：滚轮/触摸仍可滚动，但绝不出现"突然冒出的可见滚动条"）；
                 每行都给 MaxLines + 省略号，所以长句只在自己那一行内被截断，不会把卡撑高。 -->
            <ScrollViewer Grid.Row="1" x:Name="HintScroll" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          IsTabStop="False">
                <StackPanel Spacing="8">
                    <!-- 运行/流程状态（OperationalStatus；为空时显示"就绪"） -->
                    <TextBlock Style="{StaticResource PCMigTextHintBody}" TextWrapping="Wrap"
                               MaxLines="4" TextTrimming="CharacterEllipsis"
                               x:Name="HintOperationalText" Text="就绪"/>

                    <!-- 当前对象（CurrentObjectStatus；引擎真值，为空则折叠） -->
                    <TextBlock Style="{StaticResource PCMigTextHintBody}" TextWrapping="Wrap" MaxLines="3"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               x:Name="HintObjectText"/>

                    <!-- 用户操作引导（UserHint；为空则折叠） -->
                    <TextBlock Style="{StaticResource PCMigTextHintBody}" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               x:Name="HintUserText"/>

                    <!-- 错误摘要（ErrorSummary；为空则折叠） -->
                    <TextBlock Style="{StaticResource PCMigTextHintBody}" TextWrapping="Wrap" MaxLines="3"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               Foreground="{StaticResource WarningBrush}"
                               x:Name="HintErrorText"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{StaticResource SuccessBrush}"
                          VerticalAlignment="Center" x:Name="HintStatusIcon"/>
                <TextBlock Style="{StaticResource PCMigTextHintStatus}" Text="暂无报错" VerticalAlignment="Center"
                           x:Name="HintStatusText"/>
            </StackPanel>
            <Border Grid.Row="3" Height="1" Background="{StaticResource InsetBorderBrush}" Margin="0,2,0,2"/>
            <TextBlock Grid.Row="4" Style="{StaticResource PCMigTextHintCredit}">
                <Run Text="由 "/>
                <Hyperlink NavigateUri="https://github.com/AxuanBest/PCMig">
                    <Run Text="AxuanBest"/>
                </Hyperlink>
                <Run Text=" 个人制作"/>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>