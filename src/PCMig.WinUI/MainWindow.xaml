<Window x:Class="PCMig.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:PCMig.WinUI"
 xmlns:presentation="using:PCMig.WinUI.Presentation"
 Title="PCMig WinUI 3 · 连接旧电脑">
 <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
 <Grid Background="Transparent">
  <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE72D;" FontSize="19" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="PCMig 迁移工具" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="WinUI 3 · Step 1" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
   <TextBlock Grid.Column="1" Text="旧电脑 → 新电脑" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
  </Grid>
  <Grid Grid.Row="1" Padding="24"><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource ShellCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="10"><TextBlock Text="迁移步骤" Style="{StaticResource SectionTitle}" Margin="4,0,0,8"/>
    <NavigationView x:Name="StepNavigation" PaneDisplayMode="LeftMinimal" IsPaneOpen="True" IsBackButtonVisible="Collapsed" Background="Transparent"><NavigationView.MenuItems><NavigationViewItem Content="连接旧电脑" Icon="Remote" IsSelected="True"/><NavigationViewItem Content="选择数据与目标" Icon="List" IsEnabled="False"/><NavigationViewItem Content="迁移进度" Icon="Play" IsEnabled="False"/><NavigationViewItem Content="结果与校验" Icon="Accept" IsEnabled="False"/></NavigationView.MenuItems></NavigationView>
   </StackPanel><Border Grid.Row="1" Style="{StaticResource MaterialCard}"><StackPanel Spacing="5"><TextBlock Text="连接状态" Style="{StaticResource SectionTitle}" FontSize="13"/><TextBlock Text="{x:Bind ViewModel.DeviceSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="凭据仅用于当前会话" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource ShellCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="6"><TextBlock Text="连接旧电脑" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="连接设备、识别状态并发现可迁移的共享。不会开始迁移或修改任何数据。" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource MaterialCard}" Margin="0,22,0,0"><Grid RowSpacing="12" ColumnSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Header="旧电脑 IP 或电脑名" PlaceholderText="例如：192.168.1.100 或 DESKTOP-ABCD" Text="{x:Bind ViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBox Grid.Row="1" Grid.Column="0" Header="用户名（可选）" PlaceholderText="域名\账号 或 电脑名\Administrator" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <PasswordBox x:Name="PasswordInput" Grid.Row="1" Grid.Column="1" Header="密码（仅当前会话）" PlaceholderText="留空则使用当前 Windows 凭据"/>
      <ToggleSwitch Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="连接时测速" OffContent="关闭" OnContent="开启" IsOn="{x:Bind ViewModel.BenchmarkOnConnect, Mode=TwoWay}"/>
      <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Content="连接并发现共享" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}" Click="Connect_Click"/>
    </Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource MaterialCard}" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="共享工作区" Style="{StaticResource SectionTitle}"/><TextBlock Text="连接后显示可迁移共享；对方不开放枚举时可手动添加。" Style="{StaticResource MutedText}"/></StackPanel><TextBox Grid.Column="1" Header="手动共享名" PlaceholderText="d、D$ 或 Users" Text="{x:Bind ViewModel.ManualShareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="添加共享" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Click="AddShare_Click"/></Grid>
      <InfoBar Grid.Row="1" Margin="0,14,0,0" IsOpen="True" IsClosable="False" Severity="Informational" Title="连接反馈" Message="{x:Bind ViewModel.Status, Mode=OneWay}"/>
      <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="EmptySharesHint" Text="连接后将在这里显示可选共享。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/><ListView ItemsSource="{x:Bind ViewModel.Shares}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,2" CornerRadius="10" Background="#4DFFFFFF" BorderBrush="#65B7CAE4" BorderThickness="1"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding UncPath}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Remark}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid>
    </Grid></Border>
    <Button Grid.Row="3" HorizontalAlignment="Right" Content="下一步：选择数据与目标 →" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="NextStep_Click"/>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>