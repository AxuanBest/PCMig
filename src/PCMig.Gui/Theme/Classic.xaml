<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- ══════════════════════════════════════════════════════════════════════════════
         PCMig Design System · Classic（回退主题）
         与 Glass.xaml 完全同键，切换 = 换字典源，引用零改动。
         经典 = 不透明表面 + 硬边框 + 零阴影 + 零边缘光（v0.4.1 及以前的老观感）。
         ══════════════════════════════════════════════════════════════════════════════ -->

    <s:Double x:Key="LightDirection">315</s:Double>
    <s:Double x:Key="HoverDepth">0</s:Double>
    <s:Double x:Key="PressedDepth">0</s:Double>

    <!-- Surface -->
    <SolidColorBrush x:Key="SurfaceColor"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSecondary" Color="#FFEDF0F4"/>
    <SolidColorBrush x:Key="SurfaceTertiary"  Color="#FFE9ECF1"/>
    <SolidColorBrush x:Key="SurfaceHover"     Color="#FFF1F5F9"/>
    <SolidColorBrush x:Key="SurfacePressed"   Color="#FFE8EDF3"/>
    <SolidColorBrush x:Key="SurfaceSelected"  Color="#FFE4EDFB"/>
    <SolidColorBrush x:Key="SurfaceSunken"    Color="#FFF7F8FA"/>
    <SolidColorBrush x:Key="SurfacePopup"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceDialog"    Color="#FFFFFFFF"/>

    <!-- 边缘：经典用硬边框，不用渐变边缘光 -->
    <LinearGradientBrush x:Key="EdgeHighlight" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD0D7E0" Offset="0"/>
        <GradientStop Color="#FFD0D7E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EdgeHighlightStrong" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB9C2CE" Offset="0"/>
        <GradientStop Color="#FFB9C2CE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EdgeHighlightPressed" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9AA5B4" Offset="0"/>
        <GradientStop Color="#FF9AA5B4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InnerEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DividerColor" Color="#FFD0D7E0"/>

    <!-- 阴影：经典全部关闭 -->
    <DropShadowEffect x:Key="ContactShadow" BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="Elevation1"    BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="Elevation2"    BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="Elevation3"    BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="Elevation4"    BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="Elevation5"    BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="Elevation6"    BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>

    <CornerRadius x:Key="CornerRadiusSmall">3</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusWindow">6</CornerRadius>

    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentSoftColor">#93B4F5</Color>
    <Color x:Key="AccentDeepColor">#1D4ED8</Color>
    <SolidColorBrush x:Key="AccentColorBrush" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="AccentColorSoft"  Color="#FFE4EDFB"/>
    <SolidColorBrush x:Key="AccentColorText"  Color="#FF1D4ED8"/>

    <SolidColorBrush x:Key="TypographyPrimary"   Color="#FF1A1F2B"/>
    <SolidColorBrush x:Key="TypographySecondary" Color="#FF4A5568"/>
    <SolidColorBrush x:Key="TypographyMuted"     Color="#FF8A93A3"/>
    <SolidColorBrush x:Key="TypographyDisabled"  Color="#FFB0B7C3"/>
    <SolidColorBrush x:Key="TypographyOnAccent"  Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="InfoSurface"   Color="#FFEAF2FE"/>
    <SolidColorBrush x:Key="WarnSurface"   Color="#FFFFF6E5"/>
    <SolidColorBrush x:Key="ErrorSurface"  Color="#FFFFEEEC"/>
    <SolidColorBrush x:Key="SuccessColor"  Color="#FF15803D"/>
    <SolidColorBrush x:Key="WarningColor"  Color="#FFB45309"/>
    <SolidColorBrush x:Key="ErrorColor"    Color="#FFDC2626"/>

    <!-- 兼容层 -->
    <SolidColorBrush x:Key="GlassWindowBg"    Color="#FFE9ECF1"/>
    <SolidColorBrush x:Key="GlassWashBg"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassRailBg"      Color="#FFEDF0F4"/>
    <SolidColorBrush x:Key="GlassPanelBg"     Color="#FFF2F4F8"/>
    <SolidColorBrush x:Key="GlassCardBg"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassSecondaryBg" Color="#FFF7F8FA"/>
    <SolidColorBrush x:Key="GlassInnerBg"     Color="#FFF7F8FA"/>
    <SolidColorBrush x:Key="GlassInnerDeepBg" Color="#FFF1F3F7"/>
    <SolidColorBrush x:Key="GlassPopupBg"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassDialogBg"    Color="#FFFFFFFF"/>
    <Color x:Key="AmbientRose">#00FFFFFF</Color>
    <Color x:Key="AmbientAmber">#00FFFFFF</Color>
    <Color x:Key="AmbientSky">#00FFFFFF</Color>
    <LinearGradientBrush x:Key="GlassEdgeLight" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD0D7E0" Offset="0"/>
        <GradientStop Color="#FFD0D7E0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassEdgeDark"         Color="#FFB9C2CE"/>
    <SolidColorBrush x:Key="GlassBorderBrush"      Color="#FFD0D7E0"/>
    <SolidColorBrush x:Key="GlassInnerBorderBrush" Color="#FFDCE2EA"/>
    <LinearGradientBrush x:Key="GlassBevelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD0D7E0" Offset="0"/>
        <GradientStop Color="#FFD0D7E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSurfaceSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassHoverBg"        Color="#FFF1F5F9"/>
    <SolidColorBrush x:Key="GlassHoverStrongBg"  Color="#FFE8EDF3"/>
    <SolidColorBrush x:Key="GlassPressedBg"      Color="#FFE2E8F0"/>
    <SolidColorBrush x:Key="GlassSelectedBg"     Color="#FFE4EDFB"/>
    <SolidColorBrush x:Key="GlassItemHoverBg"    Color="#FFF1F5F9"/>
    <SolidColorBrush x:Key="GlassItemSelectedBg" Color="#FFE4EDFB"/>
    <SolidColorBrush x:Key="GlassAccentBrush"    Color="#FF2563EB"/>
    <SolidColorBrush x:Key="GlassAccentDeep"     Color="#FF1D4ED8"/>
    <SolidColorBrush x:Key="GlassAccentSoft"     Color="#FF93B4F5"/>
    <SolidColorBrush x:Key="GlassAccentSofter"   Color="#1A2563EB"/>
    <SolidColorBrush x:Key="GlassAccentGlow"     Color="#4D2563EB"/>
    <SolidColorBrush x:Key="GlassAccentText"     Color="#FF1D4ED8"/>
    <SolidColorBrush x:Key="GlassFocusRing"      Color="#FF2563EB"/>
    <SolidColorBrush x:Key="GlassNeutralSurface"   Color="#FFF7F8FA"/>
    <SolidColorBrush x:Key="GlassInfoSurface"      Color="#FFEAF2FE"/>
    <SolidColorBrush x:Key="GlassWarnSurface"      Color="#FFFFF6E5"/>
    <SolidColorBrush x:Key="GlassErrorSurface"     Color="#FFFFEEEC"/>
    <SolidColorBrush x:Key="GlassErrorSurfaceSoft" Color="#FFFFE4E1"/>
    <SolidColorBrush x:Key="GlassErrorHoverBg"     Color="#FFFFDAD6"/>
    <SolidColorBrush x:Key="GlassInfoEdge"         Color="#FFBFD7F7"/>
    <SolidColorBrush x:Key="GlassWarnEdge"         Color="#FFEFD5A6"/>
    <SolidColorBrush x:Key="GlassErrorEdge"        Color="#FFF3C4BF"/>
    <SolidColorBrush x:Key="GlassInfoText"         Color="#FF1D4ED8"/>
    <SolidColorBrush x:Key="GlassWarnText"         Color="#FFB45309"/>
    <SolidColorBrush x:Key="GlassErrorText"        Color="#FFDC2626"/>
    <SolidColorBrush x:Key="GlassSuccess"          Color="#FF15803D"/>
    <SolidColorBrush x:Key="GlassWarning"          Color="#FFB45309"/>
    <SolidColorBrush x:Key="GlassError"            Color="#FFDC2626"/>
    <SolidColorBrush x:Key="GlassSuccessText"      Color="#FF15803D"/>
    <SolidColorBrush x:Key="GlassTitleBrush"     Color="#FF1A1F2B"/>
    <SolidColorBrush x:Key="GlassSubTextBrush"   Color="#FF4A5568"/>
    <SolidColorBrush x:Key="GlassFaintTextBrush" Color="#FF8A93A3"/>
    <SolidColorBrush x:Key="GlassTextDisabled"   Color="#FFB0B7C3"/>
    <SolidColorBrush x:Key="GlassTextOnAccent"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassLogBg"   Color="#FFF8F8F8"/>
    <SolidColorBrush x:Key="GlassLogText" Color="#FF1A1F2B"/>
    <SolidColorBrush x:Key="GlassCardBlue"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassCardGreen"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassCardPink"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassCardPurple" Color="#FFFFFFFF"/>
    <CornerRadius x:Key="RadiusWindow">6</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">4</CornerRadius>
    <CornerRadius x:Key="RadiusInner">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusItem">3</CornerRadius>
    <CornerRadius x:Key="RadiusProgress">3</CornerRadius>
    <CornerRadius x:Key="RadiusCapsule">10</CornerRadius>
    <DropShadowEffect x:Key="Elevation0"       BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="GlassPanelShadow" BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="GlassCardShadow"  BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="GlassHoverShadow" BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="AmbientShadow"    BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="HoverShadow"      BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="PressedShadow"    BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="PopupShadow"      BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="DialogShadow"     BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#00000000"/>
    <LinearGradientBrush x:Key="EmbossSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossTopLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossBottomShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossInnerShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossInnerLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- ── 语义 Surface 边缘光（与全局光源同向：左上→右下）── -->
    <LinearGradientBrush x:Key="ErrorEdgeLight" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFF3C4BF" Offset="0"/><GradientStop Color="#FFF3C4BF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="InfoEdgeLight" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFBFD7F7" Offset="0"/><GradientStop Color="#FFBFD7F7" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="WarnEdgeLight" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFEFD5A6" Offset="0"/><GradientStop Color="#FFEFD5A6" Offset="1"/></LinearGradientBrush>
    
    <s:Double x:Key="FontPageTitle">21</s:Double>
    <s:Double x:Key="FontSectionTitle">16</s:Double>
    <s:Double x:Key="FontCardTitle">13.5</s:Double>
    <s:Double x:Key="FontBody">12.5</s:Double>
    <s:Double x:Key="FontCaption">11.5</s:Double>
    <s:Double x:Key="FontStatus">12</s:Double>
    <s:Double x:Key="FontNumber">19</s:Double>
    <Thickness x:Key="PageMargin">0</Thickness>
    <Thickness x:Key="CardPadding">16,14</Thickness>
    <Thickness x:Key="SectionSpacing">0,10,0,0</Thickness>
    <Thickness x:Key="ControlSpacing">0,8,0,0</Thickness>
    <Thickness x:Key="InnerPadding">10,8</Thickness>
</ResourceDictionary>