<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- ══════════════════════════════════════════════════════════════════════════
         PCMig Material System（v0.4.2）：全 UI 视觉参数的唯一来源。
         光源统一：左上 → 右下。因此顶部亮、底部暗、阴影一律向 315°（右下）扩散。
         层级：窗口底 → 环境光 → 面板 → 卡片 → InnerSurface → 控件 → 交互态。
         经典回退见 Classic.xaml（同键不同值，切换=换字典源，引用零改动）。
         ══════════════════════════════════════════════════════════════════════════ -->

    <!-- ══ 1. 环境光与空间底（Elevation 0） ══ -->
    <LinearGradientBrush x:Key="GlassWindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5F8FD" Offset="0"/>
        <GradientStop Color="#FDF7F5" Offset="0.55"/>
        <GradientStop Color="#F6F4FC" Offset="1"/>
    </LinearGradientBrush>
    <!-- 底景三团柔色块光晕（原硬编码在 MainWindow，抽到 token 统一调色） -->
    <Color x:Key="AmbientRose">#F7A8B4</Color>
    <Color x:Key="AmbientAmber">#FBC98A</Color>
    <Color x:Key="AmbientSky">#9EC3F7</Color>
    <SolidColorBrush x:Key="GlassWashBg" Color="#14FFFFFF"/>

    <!-- ══ 2. 表面材质（高度分层：越靠前越实、越亮） ══ -->
    <SolidColorBrush x:Key="GlassRailBg" Color="#7AFFFFFF"/>
    <SolidColorBrush x:Key="GlassPanelBg" Color="#6EFFFFFF"/>
    <SolidColorBrush x:Key="GlassCardBg" Color="#A6FFFFFF"/>
    <SolidColorBrush x:Key="GlassSecondaryBg" Color="#66FFFFFF"/>
    <!-- InnerSurface：卡片内部凹面（比卡片略深、更透，形成"嵌进材质"的观感） -->
    <SolidColorBrush x:Key="GlassInnerBg" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="GlassInnerDeepBg" Color="#3DFFFFFF"/>
    <!-- 浮层：需要读清内容，所以更实 -->
    <SolidColorBrush x:Key="GlassPopupBg" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="GlassDialogBg" Color="#F7FFFFFF"/>

    <!-- ══ 3. 玻璃折边（Bevel，5~15% 强度，替代传统 1px 硬边框） ══ -->
    <SolidColorBrush x:Key="GlassEdgeLight" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="GlassEdgeDark" Color="#0F0F172A"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="GlassInnerBorderBrush" Color="#14FFFFFF"/>
    <LinearGradientBrush x:Key="GlassBevelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33FFFFFF" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
        <GradientStop Color="#0A0F172A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSurfaceSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══ 4. 交互态 ══ -->
    <SolidColorBrush x:Key="GlassHoverBg" Color="#7AFFFFFF"/>
    <SolidColorBrush x:Key="GlassHoverStrongBg" Color="#A6FFFFFF"/>
    <SolidColorBrush x:Key="GlassPressedBg" Color="#5CFFFFFF"/>
    <SolidColorBrush x:Key="GlassSelectedBg" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="GlassItemHoverBg" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="GlassItemSelectedBg" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="GlassAccentBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="GlassAccentDeep" Color="#0069D9"/>
    <SolidColorBrush x:Key="GlassAccentSoft" Color="#2E0A84FF"/>
    <SolidColorBrush x:Key="GlassAccentSofter" Color="#1A0A84FF"/>
    <Color x:Key="AccentSoftColor">#7FBFFF</Color>
    <Color x:Key="AccentColor">#0A84FF</Color>
    <Color x:Key="AccentDeepColor">#0069D9</Color>
    <!-- ══════════ 浮雕材质（复刻参考图物理逻辑：顶部高光带 + 中段柔和主体 + 底部暗部，独立于外部投影）══════════ -->
    <LinearGradientBrush x:Key="EmbossSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.42"/>
        <GradientStop Color="#26000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#52FFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.45"/>
        <GradientStop Color="#1C000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#42000000" Offset="0"/>
        <GradientStop Color="#14000000" Offset="0.32"/>
        <GradientStop Color="#00000000" Offset="0.72"/>
        <GradientStop Color="#2B000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0"/>
        <GradientStop Color="#06FFFFFF" Offset="0.5"/>
        <GradientStop Color="#14000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossTopLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#99FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossBottomShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#1F000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossInnerShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.75"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossInnerLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.25"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassAccentGlow" Color="#4D0A84FF"/>
    <SolidColorBrush x:Key="GlassAccentText" Color="#0A5FD0"/>
    <SolidColorBrush x:Key="GlassFocusRing" Color="#660A84FF"/>

    <!-- ══ 5. 语义表面（状态卡片：低饱和玻璃，替代老式浅底+硬红边） ══ -->
    <SolidColorBrush x:Key="GlassNeutralSurface" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="GlassInfoSurface" Color="#3D2F6FED"/>
    <SolidColorBrush x:Key="GlassWarnSurface" Color="#3DFF9F0A"/>
    <SolidColorBrush x:Key="GlassErrorSurface" Color="#2EFF3B30"/>
    <SolidColorBrush x:Key="GlassErrorSurfaceSoft" Color="#1FFF3B30"/>
    <SolidColorBrush x:Key="GlassErrorHoverBg" Color="#3DFF3B30"/>
    <SolidColorBrush x:Key="GlassInfoEdge" Color="#332F6FED"/>
    <SolidColorBrush x:Key="GlassWarnEdge" Color="#33FF9F0A"/>
    <SolidColorBrush x:Key="GlassErrorEdge" Color="#33FF3B30"/>
    <SolidColorBrush x:Key="GlassInfoText" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="GlassWarnText" Color="#B45309"/>
    <SolidColorBrush x:Key="GlassErrorText" Color="#D32F2F"/>
    <SolidColorBrush x:Key="GlassSuccess" Color="#34C759"/>
    <SolidColorBrush x:Key="GlassWarning" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="GlassError" Color="#FF3B30"/>

    <!-- ══ 6. 文字 ══ -->
    <SolidColorBrush x:Key="GlassTitleBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="GlassSubTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="GlassFaintTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="GlassTextDisabled" Color="#9AA7B8"/>
    <SolidColorBrush x:Key="GlassTextOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GlassLogBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="GlassLogText" Color="#CBD5E1"/>

    <!-- ══ 7. 页面色相（极淡 tint，只给卡片底色；顶部微亮、底部柔和） ══ -->
    <LinearGradientBrush x:Key="GlassCardBlue" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DCEBFF" Offset="0"/><GradientStop Color="#F2F8FF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardGreen" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DCF5E7" Offset="0"/><GradientStop Color="#F1FBF6" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardPink" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFE4E8" Offset="0"/><GradientStop Color="#FFF5F6" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardPurple" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E9E2FB" Offset="0"/><GradientStop Color="#F7F4FE" Offset="1"/></LinearGradientBrush>

    <!-- ══ 8. 圆角层级（不把所有东西做成胶囊） ══ -->
    <CornerRadius x:Key="RadiusWindow">16</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">16</CornerRadius>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusInner">11</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <CornerRadius x:Key="RadiusItem">8</CornerRadius>
    <CornerRadius x:Key="RadiusProgress">7</CornerRadius>
    <CornerRadius x:Key="RadiusCapsule">999</CornerRadius>

    <!-- ══ 9. 高度与阴影（Direction 315 = 右下，与左上光源一致；层级越低越淡） ══ -->
    <DropShadowEffect x:Key="Elevation0" BlurRadius="0" ShadowDepth="0" Direction="315" Opacity="0" Color="#0F172A"/>
    <DropShadowEffect x:Key="Elevation1" BlurRadius="6" ShadowDepth="0.6" Direction="315" Opacity="0.05" Color="#0F172A"/>
    <DropShadowEffect x:Key="Elevation2" BlurRadius="14" ShadowDepth="1.4" Direction="315" Opacity="0.09" Color="#0F172A"/>
    <DropShadowEffect x:Key="Elevation3" BlurRadius="22" ShadowDepth="3" Direction="315" Opacity="0.14" Color="#0F172A"/>
    <DropShadowEffect x:Key="Elevation4" BlurRadius="10" ShadowDepth="1.2" Direction="315" Opacity="0.10" Color="#0F172A"/>
    <DropShadowEffect x:Key="Elevation5" BlurRadius="26" ShadowDepth="5" Direction="315" Opacity="0.20" Color="#0F172A"/>
    <DropShadowEffect x:Key="Elevation6" BlurRadius="34" ShadowDepth="7" Direction="315" Opacity="0.26" Color="#0F172A"/>
    <!-- 语义别名（旧代码引用这些 key，保留兼容；阴影效果各自独立实例，值同对应 Elevation） -->
    <DropShadowEffect x:Key="GlassPanelShadow" BlurRadius="14" ShadowDepth="1.4" Direction="315" Opacity="0.09" Color="#0F172A"/>
    <DropShadowEffect x:Key="GlassCardShadow" BlurRadius="14" ShadowDepth="1.4" Direction="315" Opacity="0.09" Color="#0F172A"/>
    <DropShadowEffect x:Key="GlassHoverShadow" BlurRadius="22" ShadowDepth="3" Direction="315" Opacity="0.14" Color="#0F172A"/>
    <DropShadowEffect x:Key="AmbientShadow" BlurRadius="6" ShadowDepth="0.6" Direction="315" Opacity="0.05" Color="#0F172A"/>
    <DropShadowEffect x:Key="ContactShadow" BlurRadius="6" ShadowDepth="0.6" Direction="315" Opacity="0.05" Color="#0F172A"/>
    <DropShadowEffect x:Key="HoverShadow" BlurRadius="22" ShadowDepth="3" Direction="315" Opacity="0.14" Color="#0F172A"/>
    <DropShadowEffect x:Key="PressedShadow" BlurRadius="5" ShadowDepth="0.5" Direction="315" Opacity="0.04" Color="#0F172A"/>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="26" ShadowDepth="5" Direction="315" Opacity="0.20" Color="#0F172A"/>
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="34" ShadowDepth="7" Direction="315" Opacity="0.26" Color="#0F172A"/>

    <!-- ══ 10. 字体层级 ══ -->
    <s:Double x:Key="FontPageTitle">26</s:Double>
    <s:Double x:Key="FontSectionTitle">19</s:Double>
    <s:Double x:Key="FontCardTitle">16</s:Double>
    <s:Double x:Key="FontBody">13</s:Double>
    <s:Double x:Key="FontCaption">11.5</s:Double>
    <s:Double x:Key="FontStatus">10.5</s:Double>
    <s:Double x:Key="FontNumber">42</s:Double>

    <!-- ══ 11. 间距 ══ -->
    <Thickness x:Key="PageMargin">24,20,24,16</Thickness>
    <Thickness x:Key="CardPadding">16,14</Thickness>
    <Thickness x:Key="SectionSpacing">0,18,0,0</Thickness>
    <Thickness x:Key="ControlSpacing">0,10,0,0</Thickness>
    <Thickness x:Key="InnerPadding">12,10</Thickness>
</ResourceDictionary>