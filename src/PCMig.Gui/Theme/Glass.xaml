<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════════════════════════════════════════════════════════════════════
         PCMig Design System · Light
         ──────────────────────────────────────────────────────────────────────────────
         视觉核心：借鉴 Apple Liquid Glass 的【边缘光学语言】，而不是它的【玻璃材质】。
         不使用透明 / 模糊 / 折射；全部为不透明现代 Surface。
         空间感只来自三件事：方向性边缘光 + 微妙内部边缘 + 极轻接触阴影。
         光源统一：左上 → 右下（LightDirection = 315）。
         经典回退见 Classic.xaml（同键不同值，切换 = 换字典源，引用零改动）。
         ══════════════════════════════════════════════════════════════════════════════ -->

    <!-- ── 0. 光源与交互深度（所有阴影手工对齐 315°） ── -->
    <s:Double x:Key="LightDirection">315</s:Double>
    <s:Double x:Key="HoverDepth">-1</s:Double>
    <s:Double x:Key="PressedDepth">1</s:Double>

    <!-- ── 1. Surface：全部不透明；层次靠色调差，不靠透明度 ── -->
    <SolidColorBrush x:Key="SurfaceColor"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSecondary" Color="#FFEFF3F8"/>
    <SolidColorBrush x:Key="SurfaceTertiary"  Color="#FFEAEEF4"/>
    <SolidColorBrush x:Key="SurfaceHover"     Color="#FFFCFDFE"/>
    <SolidColorBrush x:Key="SurfacePressed"   Color="#FFEFF2F7"/>
    <SolidColorBrush x:Key="SurfaceSelected"  Color="#FFE9F1FD"/>
    <SolidColorBrush x:Key="SurfaceSunken"    Color="#FFF4F7FA"/>
    <SolidColorBrush x:Key="SurfacePopup"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceDialog"    Color="#FFFFFFFF"/>

    <!-- ── 2. 方向性边缘光 ──
         不是「一圈白 Border」，而是光在真实表面边缘上的连续变化，所以用 45° 渐变而非纯色：
         左上最亮 → 顶部次亮 → 右侧转暗 → 右下最暗。 -->
    <RadialGradientBrush x:Key="EdgeHighlight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#33FFFFFF" Offset="0.00"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.26"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.48"/>
        <GradientStop Color="#0D000000" Offset="0.68"/>
        <GradientStop Color="#26000000" Offset="1.00"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="EdgeHighlightStrong" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#4DFFFFFF" Offset="0.00"/>
        <GradientStop Color="#26FFFFFF" Offset="0.26"/>
        <GradientStop Color="#10FFFFFF" Offset="0.48"/>
        <GradientStop Color="#14000000" Offset="0.68"/>
        <GradientStop Color="#2E000000" Offset="1.00"/>
    </RadialGradientBrush>
    <!-- 按下：方向反转（顶部转暗 = 被按进去） -->
    <RadialGradientBrush x:Key="EdgeHighlightPressed" GradientOrigin="0.94,0.92" Center="0.94,0.92" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#47000000" Offset="0.00"/>
        <GradientStop Color="#24000000" Offset="0.28"/>
        <GradientStop Color="#00000000" Offset="0.52"/>
        <GradientStop Color="#12FFFFFF" Offset="1.00"/>
    </RadialGradientBrush>
    <!-- 内部边缘：距轮廓 1px 处的极弱明暗，暗示表面厚度，绝不是传统 Bevel -->
    <RadialGradientBrush x:Key="InnerEdge" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#14FFFFFF" Offset="0.00"/>
        <GradientStop Color="#00000000" Offset="0.42"/>
        <GradientStop Color="#0F000000" Offset="1.00"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="DividerColor" Color="#FFE7EBF1"/>

    <!-- ── 3. 阴影分三层：Button Edge / External Contact / Elevation，绝不混成一团黑影 ── -->
    <DropShadowEffect x:Key="ContactShadow" BlurRadius="3"  ShadowDepth="1.2" Direction="315" Opacity="0.09" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="Elevation1"    BlurRadius="6"  ShadowDepth="2"   Direction="315" Opacity="0.10" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="Elevation2"    BlurRadius="10" ShadowDepth="3"   Direction="315" Opacity="0.11" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="Elevation3"    BlurRadius="16" ShadowDepth="4"   Direction="315" Opacity="0.12" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="Elevation4"    BlurRadius="22" ShadowDepth="6"   Direction="315" Opacity="0.13" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="Elevation5"    BlurRadius="30" ShadowDepth="8"   Direction="315" Opacity="0.14" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="Elevation6"    BlurRadius="40" ShadowDepth="12"  Direction="315" Opacity="0.16" Color="#FF0B1220"/>

    <!-- ── 4. 圆角（按组件层级给值，避免一切都变胶囊） ── -->
    <CornerRadius x:Key="CornerRadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="CornerRadiusWindow">16</CornerRadius>

    <!-- ── 5. Accent ── -->
    <Color x:Key="AccentColor">#1C6FE3</Color>
    <Color x:Key="AccentSoftColor">#8AAEE6</Color>
    <Color x:Key="AccentDeepColor">#1057BC</Color>
    <SolidColorBrush x:Key="AccentColorBrush" Color="#FF1C6FE3"/>
    <SolidColorBrush x:Key="AccentColorSoft"  Color="#FFE9F1FD"/>
    <SolidColorBrush x:Key="AccentColorText"  Color="#FF1459C0"/>

    <!-- ── 6. Typography ── -->
    <SolidColorBrush x:Key="TypographyPrimary"   Color="#FF161B26"/>
    <SolidColorBrush x:Key="TypographySecondary" Color="#FF5B6678"/>
    <SolidColorBrush x:Key="TypographyMuted"     Color="#FF8B95A7"/>
    <SolidColorBrush x:Key="TypographyDisabled"  Color="#FFB7BDC9"/>
    <SolidColorBrush x:Key="TypographyOnAccent"  Color="#FFFFFFFF"/>

    <!-- ── 7. 语义色 ── -->
    <SolidColorBrush x:Key="InfoSurface"   Color="#FFEEF5FF"/>
    <SolidColorBrush x:Key="WarnSurface"   Color="#FFFFF7EA"/>
    <SolidColorBrush x:Key="ErrorSurface"  Color="#FFFFF2F1"/>
    <SolidColorBrush x:Key="SuccessColor"  Color="#FF1F9D55"/>
    <SolidColorBrush x:Key="WarningColor"  Color="#FFC77700"/>
    <SolidColorBrush x:Key="ErrorColor"    Color="#FFD93A32"/>
    <SolidColorBrush x:Key="WarnTextColor"  Color="#FFB45309"/>
    <SolidColorBrush x:Key="ErrorTextColor" Color="#FFC62828"/>

    <!-- ══════════════════════════════════════════════════════════════════════════════
         兼容层：保留上一版全部 key（MainWindow / ChangelogWindow 仍在引用），
         取值全部改为本 Design System 的新语义 —— 旧引用自动升级，不必逐个改 XAML。
         ══════════════════════════════════════════════════════════════════════════════ -->

    <!-- 窗口与容器：不透明 Surface -->
    <SolidColorBrush x:Key="GlassWindowBg"    Color="#FFEAEEF4"/>
    <SolidColorBrush x:Key="GlassWashBg"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassRailBg"      Color="#FFEFF3F8"/>
    <SolidColorBrush x:Key="GlassPanelBg"     Color="#FFFCFDFF"/>
    <SolidColorBrush x:Key="GlassCardBg"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassSecondaryBg" Color="#FFF8FAFC"/>
    <SolidColorBrush x:Key="GlassInnerBg"     Color="#FFF4F7FA"/>
    <SolidColorBrush x:Key="GlassInnerDeepBg" Color="#FFEDF1F6"/>
    <SolidColorBrush x:Key="GlassPopupBg"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassDialogBg"    Color="#FFFFFFFF"/>

    <!-- 环境色：保留 key，改为无光晕（不再需要环境光斑） -->
    <Color x:Key="AmbientRose">#00FFFFFF</Color>
    <Color x:Key="AmbientAmber">#00FFFFFF</Color>
    <Color x:Key="AmbientSky">#00FFFFFF</Color>

    <!-- 边缘与描边：全部指向方向性边缘光 -->
    <RadialGradientBrush x:Key="GlassEdgeLight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#42FFFFFF" Offset="0.00"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.26"/>
        <GradientStop Color="#0D000000" Offset="0.66"/>
        <GradientStop Color="#2B000000" Offset="1.00"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="GlassEdgeDark"         Color="#FFD9DEE7"/>
    <SolidColorBrush x:Key="GlassBorderBrush"      Color="#FFE7EBF1"/>
    <SolidColorBrush x:Key="GlassInnerBorderBrush" Color="#FFE2E7EE"/>
    <RadialGradientBrush x:Key="GlassBevelBrush" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#38FFFFFF" Offset="0.00"/>
        <GradientStop Color="#17FFFFFF" Offset="0.30"/>
        <GradientStop Color="#0A000000" Offset="0.66"/>
        <GradientStop Color="#1F000000" Offset="1.00"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="GlassSurfaceSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0AFFFFFF" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.5"/>
        <GradientStop Color="#06000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- 交互态 Surface -->
    <SolidColorBrush x:Key="GlassHoverBg"        Color="#FFFCFDFE"/>
    <SolidColorBrush x:Key="GlassHoverStrongBg"  Color="#FFF8FAFD"/>
    <SolidColorBrush x:Key="GlassPressedBg"      Color="#FFEFF2F7"/>
    <SolidColorBrush x:Key="GlassSelectedBg"     Color="#FFE9F1FD"/>
    <SolidColorBrush x:Key="GlassItemHoverBg"    Color="#FFF4F7FA"/>
    <SolidColorBrush x:Key="GlassItemSelectedBg" Color="#FFE9F1FD"/>
    <SolidColorBrush x:Key="GlassAccentBrush"    Color="#FF1C6FE3"/>
    <SolidColorBrush x:Key="GlassAccentDeep"     Color="#FF1057BC"/>
    <SolidColorBrush x:Key="GlassAccentSoft"     Color="#FF8AAEE6"/>
    <SolidColorBrush x:Key="GlassAccentSofter"   Color="#1A1C6FE3"/>
    <SolidColorBrush x:Key="GlassAccentGlow"     Color="#4D1C6FE3"/>
    <SolidColorBrush x:Key="GlassAccentText"     Color="#FF1459C0"/>
    <SolidColorBrush x:Key="GlassFocusRing"      Color="#FF1C6FE3"/>

    <!-- 语义 Surface（兼容旧 key） -->
    <SolidColorBrush x:Key="GlassNeutralSurface"   Color="#FFF6F8FB"/>
    <SolidColorBrush x:Key="GlassInfoSurface"      Color="#FFEEF5FF"/>
    <SolidColorBrush x:Key="GlassWarnSurface"      Color="#FFFFF7EA"/>
    <SolidColorBrush x:Key="GlassErrorSurface"     Color="#FFFFF2F1"/>
    <SolidColorBrush x:Key="GlassErrorSurfaceSoft" Color="#FFFFE9E7"/>
    <SolidColorBrush x:Key="GlassErrorHoverBg"     Color="#FFFFE2DF"/>
    <SolidColorBrush x:Key="GlassInfoEdge"         Color="#FFC9DEFA"/>
    <SolidColorBrush x:Key="GlassWarnEdge"         Color="#FFF2D9A8"/>
    <SolidColorBrush x:Key="GlassErrorEdge"        Color="#FFF5C9C5"/>
    <SolidColorBrush x:Key="GlassInfoText"         Color="#FF0A5AD6"/>
    <SolidColorBrush x:Key="GlassWarnText"         Color="#FF9A5B00"/>
    <SolidColorBrush x:Key="GlassErrorText"        Color="#FFC0362E"/>
    <SolidColorBrush x:Key="GlassSuccess"          Color="#FF1F9D55"/>
    <SolidColorBrush x:Key="GlassWarning"          Color="#FFC77700"/>
    <SolidColorBrush x:Key="GlassError"            Color="#FFD93A32"/>
    <SolidColorBrush x:Key="GlassSuccessText"      Color="#FF1B8A4B"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="GlassTitleBrush"     Color="#FF161B26"/>
    <SolidColorBrush x:Key="GlassSubTextBrush"   Color="#FF5B6678"/>
    <SolidColorBrush x:Key="GlassFaintTextBrush" Color="#FF8B95A7"/>
    <SolidColorBrush x:Key="GlassTextDisabled"   Color="#FFB7BDC9"/>
    <SolidColorBrush x:Key="GlassTextOnAccent"   Color="#FFFFFFFF"/>

    <!-- 日志区：柔和深灰，不用纯黑 -->
    <SolidColorBrush x:Key="GlassLogBg"   Color="#FF1B2029"/>
    <SolidColorBrush x:Key="GlassLogText" Color="#FFC9D3E0"/>

    <!-- 页面色相：仍是不透明 Surface（色调差异由页内标题区表现，卡片保持统一白） -->
    <SolidColorBrush x:Key="GlassCardBlue"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassCardGreen"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassCardPink"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassCardPurple" Color="#FFFFFFFF"/>

    <!-- 圆角兼容别名 -->
    <CornerRadius x:Key="RadiusWindow">16</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">14</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusInner">10</CornerRadius>
    <CornerRadius x:Key="RadiusControl">9</CornerRadius>
    <CornerRadius x:Key="RadiusItem">7</CornerRadius>
    <CornerRadius x:Key="RadiusProgress">5</CornerRadius>
    <CornerRadius x:Key="RadiusCapsule">999</CornerRadius>

    <!-- 阴影兼容别名（Elevation0 = 完全无阴影） -->
    <DropShadowEffect x:Key="Elevation0"       BlurRadius="0"  ShadowDepth="0"  Direction="315" Opacity="0"    Color="#00000000"/>
    <DropShadowEffect x:Key="GlassPanelShadow" BlurRadius="5"  ShadowDepth="1.5" Direction="315" Opacity="0.07" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="GlassCardShadow"  BlurRadius="4"  ShadowDepth="1.5" Direction="315" Opacity="0.06" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="GlassHoverShadow" BlurRadius="16" ShadowDepth="4"  Direction="315" Opacity="0.12" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="AmbientShadow"    BlurRadius="30" ShadowDepth="8"  Direction="315" Opacity="0.14" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="HoverShadow"      BlurRadius="16" ShadowDepth="4"  Direction="315" Opacity="0.12" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="PressedShadow"    BlurRadius="3"  ShadowDepth="1"  Direction="315" Opacity="0.08" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="PopupShadow"      BlurRadius="30" ShadowDepth="8"  Direction="315" Opacity="0.16" Color="#FF0B1220"/>
    <DropShadowEffect x:Key="DialogShadow"     BlurRadius="40" ShadowDepth="12" Direction="315" Opacity="0.18" Color="#FF0B1220"/>

    <!-- 浮雕兼容层：上一版的大面积上下渐变在此被彻底抹平（保留 key 以免旧引用崩溃），
         空间感改由 EdgeHighlight / InnerEdge / ContactShadow 承担 -->
    <LinearGradientBrush x:Key="EmbossSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0AFFFFFF" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.7"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossTopLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossBottomShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossInnerShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossInnerLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── 语义 Surface 的边缘光：高光是「落在语义色表面上的光」（偏暖/偏冷的白，不是刺眼纯白），
         暗部是深化的语义色，因此红色提示区也拥有统一的左上→右下方向性光照 ── -->
    <RadialGradientBrush x:Key="ErrorEdgeLight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#7AFFF0EE" Offset="0"/>
        <GradientStop Color="#33FFE6E3" Offset="0.28"/>
        <GradientStop Color="#00FFFFFF" Offset="0.50"/>
        <GradientStop Color="#1FD93A32" Offset="0.72"/>
        <GradientStop Color="#3DA82A22" Offset="1.00"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="InfoEdgeLight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#7AEEF5FF" Offset="0"/>
        <GradientStop Color="#33E2EEFF" Offset="0.28"/>
        <GradientStop Color="#00FFFFFF" Offset="0.50"/>
        <GradientStop Color="#1F0A6CFF" Offset="0.72"/>
        <GradientStop Color="#3D0A5AD6" Offset="1.00"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="WarnEdgeLight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#7AFFF4EC" Offset="0"/>
        <GradientStop Color="#33FFF0E2" Offset="0.28"/>
        <GradientStop Color="#00FFFFFF" Offset="0.50"/>
        <GradientStop Color="#1FC77700" Offset="0.72"/>
        <GradientStop Color="#3DA85F00" Offset="1.00"/>
    </RadialGradientBrush>
    
    <!-- 字体与间距 -->
    <!-- ══ 滚动条（全局统一）══ 极细、低对比、Thumb 带同向边缘光 ══ -->
    <SolidColorBrush x:Key="ScrollTrack"        Color="#00000000"/>
    <SolidColorBrush x:Key="ScrollThumb"        Color="#2E5A6472"/>
    <SolidColorBrush x:Key="ScrollThumbHover"   Color="#4A5A6472"/>
    <SolidColorBrush x:Key="ScrollThumbPressed" Color="#665A6472"/>
    <CornerRadius x:Key="RadiusScroll">4</CornerRadius>
    <RadialGradientBrush x:Key="EdgeHighlightThin" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#47FFFFFF" Offset="0"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.30"/>
        <GradientStop Color="#00000000" Offset="0.55"/>
        <GradientStop Color="#14000000" Offset="0.75"/>
        <GradientStop Color="#2E000000" Offset="1.00"/>
    </RadialGradientBrush>
    <!-- ══ Layer 0：底层磨砂渐变环境 ══
         与全局光源同向（左上→右下），对比极低（约 8 级亮度差），肉眼不应看出"这是一块渐变"，
         它只是给上层的 Edge Light 与 Contact Shadow 提供一个有参照的底面。
         注意：这里只改变 Background Layer；所有 Button/Card/Nav/Dialog Surface 仍然完全不透明。 -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE3EDFA" Offset="0"/>
        <GradientStop Color="#FFE9EBF7" Offset="0.28"/>
        <GradientStop Color="#FFF8E9EC" Offset="0.58"/>
        <GradientStop Color="#FFFBEFE4" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══ Layer 1：SurfacePearl —— 悬浮实体模块的不透明表面 ══
         它不是"高级白"，而是"带极轻微冷色环境倾向的浅色实体"。
         目的：让内部 Button（SurfaceColor #FFFFFF）比它更亮，形成 Large Surface → Button 的层级。
         因此亮度比纯白压低约 10~14 级，并带很弱的冷色偏移（B 略高于 R），
         但仍属明亮、干净、柔和的浅色 UI —— 不做灰色面板、不做明显蓝色。
         内部渐变极微弱：左上略亮 → 右下略暗，与全局 45° 光源同向。 -->
    <LinearGradientBrush x:Key="SurfacePearl" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF4F7FC" Offset="0"/>
        <GradientStop Color="#FFF1F5FA" Offset="0.55"/>
        <GradientStop Color="#FFEDF1F8" Offset="1"/>
    </LinearGradientBrush>

    <s:Double x:Key="FontPageTitle">21</s:Double>
    <s:Double x:Key="FontSectionTitle">16</s:Double>
    <s:Double x:Key="FontCardTitle">13.5</s:Double>
    <s:Double x:Key="FontBody">12.5</s:Double>
    <s:Double x:Key="FontCaption">11.5</s:Double>
    <s:Double x:Key="FontStatus">12</s:Double>
    <s:Double x:Key="FontNumber">19</s:Double>
    <Thickness x:Key="PageMargin">0</Thickness>
    <Thickness x:Key="CardPadding">16,14</Thickness>
    <Thickness x:Key="SectionSpacing">0,10,0,0</Thickness>
    <Thickness x:Key="ControlSpacing">0,8,0,0</Thickness>
    <Thickness x:Key="InnerPadding">10,8</Thickness>
</ResourceDictionary>
