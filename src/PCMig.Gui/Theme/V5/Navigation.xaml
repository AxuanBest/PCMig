<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="V5.Navigation.Item" TargetType="ListBoxItem"><Setter Property="Padding" Value="15,13"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource V5.Text.Secondary}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource V5.Corner.Control}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#5CFFFFFF"/><Setter TargetName="Surface" Property="Effect" Value="{StaticResource V5.Shadow.Small}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F2F7FBFF"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource V5.Border.Accent}"/><Setter TargetName="Surface" Property="Effect" Value="{StaticResource V5.Glow.Accent}"/><Setter Property="Foreground" Value="{StaticResource V5.Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>