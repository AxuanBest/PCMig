<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 每个层都用不同 Brush、亮边与接触阴影，禁止复用一块泛白 Surface。 -->
  <Style x:Key="V5.Material.Shell" TargetType="Border"><Setter Property="Background" Value="{StaticResource V5.Material.ShellBrush}"/><Setter Property="BorderBrush" Value="{StaticResource V5.Border.Highlight}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource V5.Corner.Panel}"/><Setter Property="Padding" Value="{StaticResource V5.Spacing.Card}"/><Setter Property="Effect" Value="{StaticResource V5.Shadow.Contact}"/></Style>
  <Style x:Key="V5.Material.PrimarySurface" TargetType="Border"><Setter Property="Background" Value="{StaticResource V5.Material.PrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource V5.Border.Highlight}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource V5.Corner.Panel}"/><Setter Property="Padding" Value="{StaticResource V5.Spacing.Card}"/><Setter Property="Effect" Value="{StaticResource V5.Shadow.Medium}"/></Style>
  <Style x:Key="V5.Material.Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource V5.Material.CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource V5.Border.Highlight}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource V5.Corner.Control}"/><Setter Property="Padding" Value="16"/><Setter Property="Effect" Value="{StaticResource V5.Shadow.Small}"/></Style>
  <Style x:Key="V5.Material.InsetSurface" TargetType="Border"><Setter Property="Background" Value="{StaticResource V5.Material.InsetBrush}"/><Setter Property="BorderBrush" Value="#7CA6BDE0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource V5.Corner.Small}"/><Setter Property="Padding" Value="10"/></Style>
  <Style x:Key="V5.Material.Rail" TargetType="Border" BasedOn="{StaticResource V5.Material.Shell}"><Setter Property="Background" Value="#C9EEF5FF"/><Setter Property="Padding" Value="12"/></Style>
  <Style x:Key="V5.Material.Panel" TargetType="Border" BasedOn="{StaticResource V5.Material.PrimarySurface}"/>
</ResourceDictionary>