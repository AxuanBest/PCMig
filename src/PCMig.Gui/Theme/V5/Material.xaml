<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- v0.5 第二轮：五层 Material。环境光只属于 Layer 0，内容层始终清晰。 -->
  <Color x:Key="V5.Ambient.Blue">#FF8EBCFF</Color><Color x:Key="V5.Ambient.Violet">#FFB7AAFF</Color><Color x:Key="V5.Ambient.Pink">#FFFFC1D2</Color><Color x:Key="V5.Ambient.Warm">#FFFFD7AF</Color>
  <Color x:Key="V5.Accent.Color">#FF1677F2</Color><Color x:Key="V5.Accent.HoverColor">#FF075FD8</Color>
  <Color x:Key="V5.Text.PrimaryColor">#FF10264B</Color><Color x:Key="V5.Text.SecondaryColor">#FF4E668A</Color><Color x:Key="V5.Text.MutedColor">#FF7A8FAA</Color>
  <Color x:Key="V5.Success.Color">#FF119C68</Color><Color x:Key="V5.Warning.Color">#FFC98510</Color><Color x:Key="V5.Danger.Color">#FFD44152</Color>
  <SolidColorBrush x:Key="V5.Text.Primary" Color="{StaticResource V5.Text.PrimaryColor}"/><SolidColorBrush x:Key="V5.Text.Secondary" Color="{StaticResource V5.Text.SecondaryColor}"/><SolidColorBrush x:Key="V5.Text.Muted" Color="{StaticResource V5.Text.MutedColor}"/>
  <SolidColorBrush x:Key="V5.Accent" Color="{StaticResource V5.Accent.Color}"/><SolidColorBrush x:Key="V5.Success" Color="{StaticResource V5.Success.Color}"/><SolidColorBrush x:Key="V5.Warning" Color="{StaticResource V5.Warning.Color}"/><SolidColorBrush x:Key="V5.Danger" Color="{StaticResource V5.Danger.Color}"/>
  <!-- Layer 0: AppBackground，低饱和环境光，绝不充当内容 Surface。 -->
  <LinearGradientBrush x:Key="V5.AppBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFB7D1F5"/><GradientStop Color="#FFD7D5F1" Offset="0.48"/><GradientStop Color="#FFF4D8DD" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="V5.Ambient.Background" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFB7D1F5"/><GradientStop Color="#FFD7D5F1" Offset="0.48"/><GradientStop Color="#FFF4D8DD" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="V5.Ambient.Glow" Color="#24FFFFFF"/>
  <!-- Layer 1: Shell / Layer 2: Primary / Layer 3: Card / Layer 4: Inset。 -->
  <SolidColorBrush x:Key="V5.Material.ShellBrush" Color="#D9F7FAFF"/>
  <SolidColorBrush x:Key="V5.Material.PrimaryBrush" Color="#EDF9FBFF"/>
  <SolidColorBrush x:Key="V5.Material.CardBrush" Color="#DDFBFCFF"/>
  <SolidColorBrush x:Key="V5.Material.InsetBrush" Color="#FFF1F5FA"/>
  <SolidColorBrush x:Key="V5.Material.SelectedBrush" Color="#EAF2F8FF"/>
  <!-- 兼容旧资源键：仅供已有 V5 样式，禁止新区域混用。 -->
  <StaticResource x:Key="V5.Material.Base" ResourceKey="V5.Material.PrimaryBrush"/><StaticResource x:Key="V5.Material.Soft" ResourceKey="V5.Material.CardBrush"/><StaticResource x:Key="V5.Material.Strong" ResourceKey="V5.Material.PrimaryBrush"/><StaticResource x:Key="V5.Material.Selected" ResourceKey="V5.Material.SelectedBrush"/>
  <LinearGradientBrush x:Key="V5.Border.Highlight" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DFFFFFFF"/><GradientStop Color="#877FA5D4" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="V5.Border.Soft" Color="#99FFFFFF"/><SolidColorBrush x:Key="V5.Border.Strong" Color="#B1B4C9E1"/><SolidColorBrush x:Key="V5.Border.Accent" Color="#B11677F2"/>
  <CornerRadius x:Key="V5.Corner.Small">10</CornerRadius><CornerRadius x:Key="V5.Corner.Control">14</CornerRadius><CornerRadius x:Key="V5.Corner.Panel">22</CornerRadius>
  <Thickness x:Key="V5.Spacing.Page">22</Thickness><Thickness x:Key="V5.Spacing.Card">20</Thickness>
  <DropShadowEffect x:Key="V5.Shadow.Contact" BlurRadius="18" ShadowDepth="3" Opacity="0.12" Color="#FF385A86"/><DropShadowEffect x:Key="V5.Shadow.Medium" BlurRadius="30" ShadowDepth="6" Opacity="0.15" Color="#FF385A86"/><DropShadowEffect x:Key="V5.Shadow.Small" BlurRadius="13" ShadowDepth="2" Opacity="0.10" Color="#FF385A86"/><DropShadowEffect x:Key="V5.Glow.Accent" BlurRadius="16" ShadowDepth="0" Opacity="0.24" Color="#FF1677F2"/>
</ResourceDictionary>