<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="V5.Button.Base" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource V5.Text.Primary}"/><Setter Property="Background" Value="#F7FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource V5.Border.Highlight}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource V5.Corner.Control}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Effect" Value="{StaticResource V5.Shadow.Contact}"/><Setter TargetName="Surface" Property="Opacity" Value="0.98"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/><Setter TargetName="Surface" Property="Margin" Value="0,1,0,-1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="V5.Button.Primary" TargetType="Button" BasedOn="{StaticResource V5.Button.Base}"><Setter Property="Foreground" Value="White"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF48A9FF"/><GradientStop Color="#FF1677F2" Offset="0.48"/><GradientStop Color="#FF075FCC" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="BorderBrush" Value="#BFFFFFFF"/><Setter Property="Effect" Value="{StaticResource V5.Glow.Accent}"/></Style>
  <Style x:Key="V5.Button.Secondary" TargetType="Button" BasedOn="{StaticResource V5.Button.Base}"/><Style x:Key="V5.Button.Ghost" TargetType="Button" BasedOn="{StaticResource V5.Button.Base}"><Setter Property="Background" Value="#42FFFFFF"/><Setter Property="BorderBrush" Value="#58B1C9E9"/></Style><Style x:Key="V5.Button.Danger" TargetType="Button" BasedOn="{StaticResource V5.Button.Base}"><Setter Property="Foreground" Value="{StaticResource V5.Danger}"/></Style>
</ResourceDictionary>