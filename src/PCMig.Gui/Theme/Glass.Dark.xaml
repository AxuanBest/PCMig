<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- ══════════════════════════════════════════════════════════════════════════════
         PCMig Design System · Dark
         与 Glass.xaml 完全同键，切换 = 换字典源，引用零改动。
         深色不是"白改黑"：Surface 仍然不透明，边缘光改为"顶部弱白 → 右下更深"，
         接触阴影更收敛（深色底上阴影本来就该轻），文字对比重新配平。
         启用：环境变量 PCMIG_THEME=dark，或 exe 旁 dark-ui.flag 文件。
         ══════════════════════════════════════════════════════════════════════════════ -->

    <s:Double x:Key="LightDirection">315</s:Double>
    <s:Double x:Key="HoverDepth">-1</s:Double>
    <s:Double x:Key="PressedDepth">1</s:Double>

    <!-- Surface（不透明深色，靠色调差分层） -->
    <SolidColorBrush x:Key="SurfaceColor"     Color="#FF232932"/>
    <SolidColorBrush x:Key="SurfaceSecondary" Color="#FF171B22"/>
    <SolidColorBrush x:Key="SurfaceTertiary"  Color="#FF12161C"/>
    <SolidColorBrush x:Key="SurfaceHover"     Color="#FF272E38"/>
    <SolidColorBrush x:Key="SurfacePressed"   Color="#FF1A1F26"/>
    <SolidColorBrush x:Key="SurfaceSelected"  Color="#FF243449"/>
    <SolidColorBrush x:Key="SurfaceSunken"    Color="#FF191D24"/>
    <SolidColorBrush x:Key="SurfacePopup"     Color="#FF262C35"/>
    <SolidColorBrush x:Key="SurfaceDialog"    Color="#FF262C35"/>

    <!-- 方向性边缘光（深色版：左上弱白 → 右下深黑） -->
    <RadialGradientBrush x:Key="EdgeHighlight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#42FFFFFF" Offset="0.00"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.26"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.48"/>
        <GradientStop Color="#26000000" Offset="0.68"/>
        <GradientStop Color="#5C000000" Offset="1.00"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="EdgeHighlightStrong" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#66FFFFFF" Offset="0.00"/>
        <GradientStop Color="#30FFFFFF" Offset="0.26"/>
        <GradientStop Color="#10FFFFFF" Offset="0.48"/>
        <GradientStop Color="#38000000" Offset="0.68"/>
        <GradientStop Color="#75000000" Offset="1.00"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="EdgeHighlightPressed" GradientOrigin="0.94,0.92" Center="0.94,0.92" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#66000000" Offset="0.00"/>
        <GradientStop Color="#3A000000" Offset="0.28"/>
        <GradientStop Color="#00000000" Offset="0.52"/>
        <GradientStop Color="#1FFFFFFF" Offset="1.00"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="InnerEdge" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#17FFFFFF" Offset="0.00"/>
        <GradientStop Color="#00000000" Offset="0.42"/>
        <GradientStop Color="#1F000000" Offset="1.00"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="DividerColor" Color="#FF333A45"/>

    <!-- 阴影（深色底上更收敛） -->
    <DropShadowEffect x:Key="ContactShadow" BlurRadius="3"  ShadowDepth="1.2" Direction="315" Opacity="0.28" Color="#FF000000"/>
    <DropShadowEffect x:Key="Elevation1"    BlurRadius="6"  ShadowDepth="2"   Direction="315" Opacity="0.30" Color="#FF000000"/>
    <DropShadowEffect x:Key="Elevation2"    BlurRadius="10" ShadowDepth="3"   Direction="315" Opacity="0.32" Color="#FF000000"/>
    <DropShadowEffect x:Key="Elevation3"    BlurRadius="16" ShadowDepth="4"   Direction="315" Opacity="0.34" Color="#FF000000"/>
    <DropShadowEffect x:Key="Elevation4"    BlurRadius="22" ShadowDepth="6"   Direction="315" Opacity="0.36" Color="#FF000000"/>
    <DropShadowEffect x:Key="Elevation5"    BlurRadius="30" ShadowDepth="8"   Direction="315" Opacity="0.38" Color="#FF000000"/>
    <DropShadowEffect x:Key="Elevation6"    BlurRadius="40" ShadowDepth="12"  Direction="315" Opacity="0.42" Color="#FF000000"/>

    <CornerRadius x:Key="CornerRadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="CornerRadiusWindow">16</CornerRadius>

    <Color x:Key="AccentColor">#3D8BFF</Color>
    <Color x:Key="AccentSoftColor">#8FBAFF</Color>
    <Color x:Key="AccentDeepColor">#2A6FE0</Color>
    <SolidColorBrush x:Key="AccentColorBrush" Color="#FF3D8BFF"/>
    <SolidColorBrush x:Key="AccentColorSoft"  Color="#FF243449"/>
    <SolidColorBrush x:Key="AccentColorText"  Color="#FF7FB3FF"/>

    <SolidColorBrush x:Key="TypographyPrimary"   Color="#FFE9EDF3"/>
    <SolidColorBrush x:Key="TypographySecondary" Color="#FFA7B1C0"/>
    <SolidColorBrush x:Key="TypographyMuted"     Color="#FF7B8494"/>
    <SolidColorBrush x:Key="TypographyDisabled"  Color="#FF5A6270"/>
    <SolidColorBrush x:Key="TypographyOnAccent"  Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="InfoSurface"   Color="#FF1C2A3D"/>
    <SolidColorBrush x:Key="WarnSurface"   Color="#FF2E2718"/>
    <SolidColorBrush x:Key="ErrorSurface"  Color="#FF31211F"/>
    <SolidColorBrush x:Key="SuccessColor"  Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="WarningColor"  Color="#FFF5B942"/>
    <SolidColorBrush x:Key="ErrorColor"    Color="#FFF87171"/>

    <!-- 兼容层 -->
    <SolidColorBrush x:Key="GlassWindowBg"    Color="#FF12161C"/>
    <SolidColorBrush x:Key="GlassWashBg"      Color="#FF1E232B"/>
    <SolidColorBrush x:Key="GlassRailBg"      Color="#FF171B22"/>
    <SolidColorBrush x:Key="GlassPanelBg"     Color="#FF1B2027"/>
    <SolidColorBrush x:Key="GlassCardBg"      Color="#FF232932"/>
    <SolidColorBrush x:Key="GlassSecondaryBg" Color="#FF232932"/>
    <SolidColorBrush x:Key="GlassInnerBg"     Color="#FF191D24"/>
    <SolidColorBrush x:Key="GlassInnerDeepBg" Color="#FF15181E"/>
    <SolidColorBrush x:Key="GlassPopupBg"     Color="#FF262C35"/>
    <SolidColorBrush x:Key="GlassDialogBg"    Color="#FF262C35"/>
    <Color x:Key="AmbientRose">#00FFFFFF</Color>
    <Color x:Key="AmbientAmber">#00FFFFFF</Color>
    <Color x:Key="AmbientSky">#00FFFFFF</Color>
    <RadialGradientBrush x:Key="GlassEdgeLight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#47FFFFFF" Offset="0.00"/>
        <GradientStop Color="#26FFFFFF" Offset="0.30"/>
        <GradientStop Color="#1F000000" Offset="0.66"/>
        <GradientStop Color="#52000000" Offset="1.00"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="GlassEdgeDark"         Color="#FF10131A"/>
    <SolidColorBrush x:Key="GlassBorderBrush"      Color="#FF333A45"/>
    <SolidColorBrush x:Key="GlassInnerBorderBrush" Color="#FF2B323C"/>
    <RadialGradientBrush x:Key="GlassBevelBrush" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#33FFFFFF" Offset="0.00"/>
        <GradientStop Color="#16FFFFFF" Offset="0.35"/>
        <GradientStop Color="#16000000" Offset="0.70"/>
        <GradientStop Color="#40000000" Offset="1.00"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="GlassSurfaceSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#08FFFFFF" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.5"/>
        <GradientStop Color="#0A000000" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassHoverBg"        Color="#FF272E38"/>
    <SolidColorBrush x:Key="GlassHoverStrongBg"  Color="#FF2C343F"/>
    <SolidColorBrush x:Key="GlassPressedBg"      Color="#FF1A1F26"/>
    <SolidColorBrush x:Key="GlassSelectedBg"     Color="#FF243449"/>
    <SolidColorBrush x:Key="GlassItemHoverBg"    Color="#FF232932"/>
    <SolidColorBrush x:Key="GlassItemSelectedBg" Color="#FF243449"/>
    <SolidColorBrush x:Key="GlassAccentBrush"    Color="#FF3D8BFF"/>
    <SolidColorBrush x:Key="GlassAccentDeep"     Color="#FF2A6FE0"/>
    <SolidColorBrush x:Key="GlassAccentSoft"     Color="#FF8FBAFF"/>
    <SolidColorBrush x:Key="GlassAccentSofter"   Color="#262A6FE0"/>
    <SolidColorBrush x:Key="GlassAccentGlow"     Color="#4D3D8BFF"/>
    <SolidColorBrush x:Key="GlassAccentText"     Color="#FF7FB3FF"/>
    <SolidColorBrush x:Key="GlassFocusRing"      Color="#FF3D8BFF"/>
    <SolidColorBrush x:Key="GlassNeutralSurface"   Color="#FF232932"/>
    <SolidColorBrush x:Key="GlassInfoSurface"      Color="#FF1C2A3D"/>
    <SolidColorBrush x:Key="GlassWarnSurface"      Color="#FF2E2718"/>
    <SolidColorBrush x:Key="GlassErrorSurface"     Color="#FF31211F"/>
    <SolidColorBrush x:Key="GlassErrorSurfaceSoft" Color="#FF3A2724"/>
    <SolidColorBrush x:Key="GlassErrorHoverBg"     Color="#FF442C28"/>
    <SolidColorBrush x:Key="GlassInfoEdge"         Color="#FF2E4664"/>
    <SolidColorBrush x:Key="GlassWarnEdge"         Color="#FF4D3F22"/>
    <SolidColorBrush x:Key="GlassErrorEdge"        Color="#FF57332E"/>
    <SolidColorBrush x:Key="GlassInfoText"         Color="#FF6FA8FF"/>
    <SolidColorBrush x:Key="GlassWarnText"         Color="#FFF5B942"/>
    <SolidColorBrush x:Key="GlassErrorText"        Color="#FFF87171"/>
    <SolidColorBrush x:Key="GlassSuccess"          Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="GlassWarning"          Color="#FFF5B942"/>
    <SolidColorBrush x:Key="GlassError"            Color="#FFF87171"/>
    <SolidColorBrush x:Key="GlassSuccessText"      Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="GlassTitleBrush"     Color="#FFE9EDF3"/>
    <SolidColorBrush x:Key="GlassSubTextBrush"   Color="#FFA7B1C0"/>
    <SolidColorBrush x:Key="GlassFaintTextBrush" Color="#FF7B8494"/>
    <SolidColorBrush x:Key="GlassTextDisabled"   Color="#FF5A6270"/>
    <SolidColorBrush x:Key="GlassTextOnAccent"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassLogBg"   Color="#FF12161B"/>
    <SolidColorBrush x:Key="GlassLogText" Color="#FFB9C6D6"/>
    <SolidColorBrush x:Key="GlassCardBlue"   Color="#FF1E232B"/>
    <SolidColorBrush x:Key="GlassCardGreen"  Color="#FF1E232B"/>
    <SolidColorBrush x:Key="GlassCardPink"   Color="#FF1E232B"/>
    <SolidColorBrush x:Key="GlassCardPurple" Color="#FF1E232B"/>
    <CornerRadius x:Key="RadiusWindow">16</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">14</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusInner">10</CornerRadius>
    <CornerRadius x:Key="RadiusControl">9</CornerRadius>
    <CornerRadius x:Key="RadiusItem">7</CornerRadius>
    <CornerRadius x:Key="RadiusProgress">5</CornerRadius>
    <CornerRadius x:Key="RadiusCapsule">999</CornerRadius>
    <DropShadowEffect x:Key="Elevation0"       BlurRadius="0"  ShadowDepth="0"  Direction="315" Opacity="0"    Color="#00000000"/>
    <DropShadowEffect x:Key="GlassPanelShadow" BlurRadius="10" ShadowDepth="3"  Direction="315" Opacity="0.30" Color="#FF000000"/>
    <DropShadowEffect x:Key="GlassCardShadow"  BlurRadius="6"  ShadowDepth="2"  Direction="315" Opacity="0.28" Color="#FF000000"/>
    <DropShadowEffect x:Key="GlassHoverShadow" BlurRadius="16" ShadowDepth="4"  Direction="315" Opacity="0.34" Color="#FF000000"/>
    <DropShadowEffect x:Key="AmbientShadow"    BlurRadius="30" ShadowDepth="8"  Direction="315" Opacity="0.38" Color="#FF000000"/>
    <DropShadowEffect x:Key="HoverShadow"      BlurRadius="16" ShadowDepth="4"  Direction="315" Opacity="0.34" Color="#FF000000"/>
    <DropShadowEffect x:Key="PressedShadow"    BlurRadius="3"  ShadowDepth="1"  Direction="315" Opacity="0.24" Color="#FF000000"/>
    <DropShadowEffect x:Key="PopupShadow"      BlurRadius="30" ShadowDepth="8"  Direction="315" Opacity="0.44" Color="#FF000000"/>
    <DropShadowEffect x:Key="DialogShadow"     BlurRadius="40" ShadowDepth="12" Direction="315" Opacity="0.48" Color="#FF000000"/>
    <LinearGradientBrush x:Key="EmbossSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0FFFFFFF" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#29000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.7"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossSheenSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossTopLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossBottomShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossInnerShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmbossInnerLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- ══ 滚动条（全局统一）══ -->
    <SolidColorBrush x:Key="ScrollTrack"        Color="#00000000"/>
    <SolidColorBrush x:Key="ScrollThumb"        Color="#38A8B4C4"/>
    <SolidColorBrush x:Key="ScrollThumbHover"   Color="#5CA8B4C4"/>
    <SolidColorBrush x:Key="ScrollThumbPressed" Color="#78A8B4C4"/>
    <CornerRadius x:Key="RadiusScroll">4</CornerRadius>
    <RadialGradientBrush x:Key="EdgeHighlightThin" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#38FFFFFF" Offset="0"/>
        <GradientStop Color="#17FFFFFF" Offset="0.30"/>
        <GradientStop Color="#00000000" Offset="0.55"/>
        <GradientStop Color="#26000000" Offset="0.75"/>
        <GradientStop Color="#40000000" Offset="1.00"/>
    </RadialGradientBrush>

    <!-- ── 语义 Surface 边缘光（与全局光源同向：左上→右下）── -->
    <RadialGradientBrush x:Key="ErrorEdgeLight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#5CF87171" Offset="0"/>
        <GradientStop Color="#26F87171" Offset="0.28"/>
        <GradientStop Color="#00FFFFFF" Offset="0.50"/>
        <GradientStop Color="#26F87171" Offset="0.72"/>
        <GradientStop Color="#47B91C1C" Offset="1.00"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="InfoEdgeLight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#5C6FA8FF" Offset="0"/>
        <GradientStop Color="#266FA8FF" Offset="0.28"/>
        <GradientStop Color="#00FFFFFF" Offset="0.50"/>
        <GradientStop Color="#266FA8FF" Offset="0.72"/>
        <GradientStop Color="#473D8BFF" Offset="1.00"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="WarnEdgeLight" GradientOrigin="0.06,0.08" Center="0.06,0.08" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Color="#5CF5B942" Offset="0"/>
        <GradientStop Color="#26F5B942" Offset="0.28"/>
        <GradientStop Color="#00FFFFFF" Offset="0.50"/>
        <GradientStop Color="#26F5B942" Offset="0.72"/>
        <GradientStop Color="#47B45309" Offset="1.00"/>
    </RadialGradientBrush>
    
    <!-- ══ Layer 0：底层磨砂渐变环境 ══
         与全局光源同向（左上→右下），对比极低，肉眼不应看出"这是一块渐变"。
         只改变 Background Layer；所有 Surface 仍然完全不透明。 -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF171C23" Offset="0"/>
        <GradientStop Color="#FF141920" Offset="0.55"/>
        <GradientStop Color="#FF11151B" Offset="1"/>
    </LinearGradientBrush>

    <s:Double x:Key="FontPageTitle">21</s:Double>
    <s:Double x:Key="FontSectionTitle">16</s:Double>
    <s:Double x:Key="FontCardTitle">13.5</s:Double>
    <s:Double x:Key="FontBody">12.5</s:Double>
    <s:Double x:Key="FontCaption">11.5</s:Double>
    <s:Double x:Key="FontStatus">12</s:Double>
    <s:Double x:Key="FontNumber">19</s:Double>
    <Thickness x:Key="PageMargin">0</Thickness>
    <Thickness x:Key="CardPadding">16,14</Thickness>
    <Thickness x:Key="SectionSpacing">0,10,0,0</Thickness>
    <Thickness x:Key="ControlSpacing">0,8,0,0</Thickness>
    <Thickness x:Key="InnerPadding">10,8</Thickness>
</ResourceDictionary>