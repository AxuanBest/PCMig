<Window x:Class="PCMig.Gui.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCMig 迁移工具 · 更新日志" Width="1040" Height="740" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource V5.Ambient.Background}"
        Icon="/PCMig;component/Assets/pcmig-64.png" FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- v0.5 Material changelog：保留版本列表、正文和所有现有事件。 -->
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource V5.Material.Panel}" Padding="18,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image Source="/PCMig;component/Assets/pcmig-64.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="更新日志" Style="{StaticResource V5.Text.SectionTitle}"/><TextBlock x:Name="HeaderCaption" Style="{StaticResource V5.Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource V5.Status.Badge}" VerticalAlignment="Center"><TextBlock Text="版本历史" Style="{StaticResource V5.Text.Caption}"/></Border>
        </Grid></Border>
        <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource V5.Material.Panel}" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="版本（新 → 旧）" Style="{StaticResource V5.Text.Caption}" Margin="6,4,0,8"/>
                <ListBox x:Name="VerList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="VerList_SelectionChanged" PreviewMouseLeftButtonUp="VerList_PreviewMouseUp" ItemContainerStyle="{StaticResource V5.Navigation.Item}">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Version}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource V5.Accent}"/><TextBlock Text="{Binding Title}" Style="{StaticResource V5.Text.Caption}" TextWrapping="Wrap"/><TextBlock Text="{Binding Date}" Style="{StaticResource V5.Text.Caption}" Opacity="0.72"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource V5.Material.Panel}" Padding="8"><ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" Padding="16,13"><StackPanel x:Name="BodyPanel"/></ScrollViewer></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterHint" Style="{StaticResource V5.Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnPrevVer" Content="◀ 上一版" Click="PrevVer_Click" Style="{StaticResource V5.Button.Ghost}" Margin="0,0,8,0"/><Button x:Name="BtnNextVer" Content="下一版 ▶" Click="NextVer_Click" Style="{StaticResource V5.Button.Ghost}" Margin="0,0,8,0"/><Button x:Name="BtnOpenTxt" Content="用记事本打开 TXT" Click="OpenTxt_Click" Style="{StaticResource V5.Button.Secondary}" Margin="0,0,8,0"/><Button x:Name="BtnClose" Content="关闭" Click="Close_Click" Style="{StaticResource V5.Button.Primary}"/></StackPanel>
        </Grid>
    </Grid>
</Window>