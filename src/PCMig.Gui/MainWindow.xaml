<Window x:Class="PCMig.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCMig.Gui"
        Title="PCMig 迁移工具 v0.4.1" Width="1340" Height="880"
        MinWidth="1120" MinHeight="740"
        Icon="/PCMig;component/Assets/pcmig.ico"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource GlassWindowBg}">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- ═══ 卡片与文字样式 ═══ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassCardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource GlassCardShadow}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource GlassHoverShadow}"/>
                    <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter>
                </Trigger>
            </Style.Triggers>
            
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassFaintTextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlassSubTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlassFaintTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlassFaintTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- ══ 按钮 ══ -->
<!-- ══════════ 按钮（Elevation4）：Hover 浮起＋高光增强；Pressed 压下＋阴影收缩 ══════════ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTextOnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="0"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusControl}"
                                Padding="{TemplateBinding Padding}"
                                Effect="{DynamicResource Elevation4}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="hoverLight" CornerRadius="{DynamicResource RadiusControl}" IsHitTestVisible="False"
                                        Background="White" Opacity="0"/>
                                <Border x:Name="pressShade" CornerRadius="{DynamicResource RadiusControl}" IsHitTestVisible="False"
                                        Background="Black" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation3}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="-1.5"/></Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverLight" Storyboard.TargetProperty="Opacity"
                                                             To="0.15" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverLight" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource PressedShadow}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="0.5"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="hoverLight" Property="Opacity" Value="0.06"/>
                                <Setter TargetName="pressShade" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassInnerDeepBg}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation0}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassTextDisabled}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NormalButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="{DynamicResource GlassCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="0"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 玻璃折边：外圈极淡亮边（左上亮、右下暗），厚度靠一条 Border 模拟，避免 1px 硬框 -->
                            <Border x:Name="edge" CornerRadius="{DynamicResource RadiusControl}"
                                    BorderBrush="{DynamicResource GlassBevelBrush}" BorderThickness="1"
                                    Background="Transparent"/>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource RadiusControl}"
                                    Padding="{TemplateBinding Padding}"
                                    Effect="{DynamicResource Elevation4}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="hoverLight" CornerRadius="{DynamicResource RadiusControl}" IsHitTestVisible="False"
                                            Background="White" Opacity="0"/>
                                    <Border x:Name="pressShade" CornerRadius="{DynamicResource RadiusControl}" IsHitTestVisible="False"
                                            Background="Black" Opacity="0"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassHoverStrongBg}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation3}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="-1.5"/></Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverLight" Storyboard.TargetProperty="Opacity"
                                                             To="0.22" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverLight" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassPressedBg}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource PressedShadow}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="0.5"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="pressShade" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassInnerDeepBg}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation0}"/>
                                <Setter TargetName="edge" Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassTextDisabled}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ 进度条：大号（迁移页）+ 细条（状态栏），圆角渐变 + 流动光带 ══ -->
        <Style x:Key="BigProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="{StaticResource RadiusProgress}" Background="{StaticResource GlassInnerDeepBg}"/>
                            <Border x:Name="PART_Track" CornerRadius="{StaticResource RadiusProgress}" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="{StaticResource RadiusProgress}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.55"/>
                                            <GradientStop Color="{DynamicResource AccentDeepColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid ClipToBounds="True">
                                        <Rectangle Width="140" HorizontalAlignment="Left" IsHitTestVisible="False">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="ShimmerX" X="-160"/>
                                            </Rectangle.RenderTransform>
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                            <Rectangle.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="ShimmerX"
                                                                             Storyboard.TargetProperty="X"
                                                                             From="-160" To="1600" Duration="0:0:2.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Rectangle.Triggers>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="{StaticResource RadiusProgress}" Background="{StaticResource GlassInnerDeepBg}"/>
                            <Border x:Name="PART_Track" CornerRadius="{StaticResource RadiusProgress}" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="{StaticResource RadiusProgress}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ 页面切换：200ms 淡入 + 轻微上移（仅视觉） ══ -->
        <Style x:Key="PageFade" TargetType="Grid">
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.2"/>
                        </Storyboard></BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ══ 左侧步骤导轨 ═══ -->
<!-- ══════════ 左侧四步导航（Elevation2→3）：Hover 亮面浮起；Selected 白色玻璃胶囊＋强调色 ══════════ -->
        <Style x:Key="StepRail" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,9"/>
                        <Setter Property="Margin" Value="0,2,0,2"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value><TranslateTransform Y="0"/></Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Border x:Name="hoverLight" CornerRadius="{DynamicResource RadiusControl}"
                                                    IsHitTestVisible="False" Background="White" Opacity="0"/>
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassHoverBg}"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value><TranslateTransform Y="-1"/></Setter.Value>
                                            </Setter>
                                            <Setter TargetName="hoverLight" Property="Opacity" Value="0.18"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseCaptured" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value><TranslateTransform Y="0.5"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassSelectedBg}"/>
                                            <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation2}"/>
                                            <Setter TargetName="hoverLight" Property="Opacity" Value="0.20"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

<!-- ══════════ 输入控件：嵌入式材质（Hover 亮起 / Focus 强调描边＋微光，不做 Y 位移） ══════════ -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource GlassInnerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource GlassAccentGlow}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource RadiusControl}"/>
                            <Border x:Name="edge" CornerRadius="{DynamicResource RadiusControl}"
                                    BorderBrush="{DynamicResource GlassBevelBrush}" BorderThickness="1"
                                    IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassHoverBg}"/>
                                <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource GlassEdgeLight}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassHoverStrongBg}"/>
                                <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                                <Setter TargetName="edge" Property="BorderThickness" Value="1.4"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="9" ShadowDepth="0" Opacity="0.40" Color="{DynamicResource AccentColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassInnerDeepBg}"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassTextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource GlassInnerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource RadiusControl}"/>
                            <Border x:Name="edge" CornerRadius="{DynamicResource RadiusControl}"
                                    BorderBrush="{DynamicResource GlassBevelBrush}" BorderThickness="1"
                                    IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassHoverBg}"/>
                                <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource GlassEdgeLight}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassHoverStrongBg}"/>
                                <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                                <Setter TargetName="edge" Property="BorderThickness" Value="1.4"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="9" ShadowDepth="0" Opacity="0.40" Color="{DynamicResource AccentColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassInnerDeepBg}"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassTextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ 下拉框：闭合=嵌入式材质＋现代细箭头；Popup=独立浮层（Elevation5） ══════════ -->
        <Style x:Key="GlassComboToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GlassInnerBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource RadiusControl}"/>
                            <Border x:Name="edge" CornerRadius="{DynamicResource RadiusControl}"
                                    BorderBrush="{DynamicResource GlassBevelBrush}" BorderThickness="1"
                                    IsHitTestVisible="False"/>
                            <ToggleButton x:Name="toggle" Style="{StaticResource GlassComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                <Path x:Name="arrow" Grid.Column="1" VerticalAlignment="Center" Margin="8,1,0,0"
                                      Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="{DynamicResource GlassSubTextBrush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   VerticalOffset="4" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource GlassPopupBg}"
                                        CornerRadius="{DynamicResource RadiusInner}"
                                        BorderBrush="{DynamicResource GlassBevelBrush}" BorderThickness="1"
                                        Effect="{DynamicResource PopupShadow}"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassHoverBg}"/>
                                <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource GlassEdgeLight}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassHoverStrongBg}"/>
                                <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource GlassAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassTextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource RadiusItem}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassAccentSofter}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassAccentSofter}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassAccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassAccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ 开关：iOS 胶囊（全局 40×24；树内用 TreeCheckBox 28×18） ══════════ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="40" Height="24" VerticalAlignment="Center">
                                <Border x:Name="track" CornerRadius="12" Background="{DynamicResource GlassInnerDeepBg}"
                                        BorderBrush="{DynamicResource GlassInnerBorderBrush}" BorderThickness="1"/>
                                <Border x:Name="thumb" Width="20" Height="20" CornerRadius="10" Background="White"
                                        HorizontalAlignment="Left" Margin="2,0,0,0" Effect="{DynamicResource Elevation1}">
                                    <Border.RenderTransform><TranslateTransform x:Name="thumbX" X="0"/></Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="thumb" Property="Effect" Value="{DynamicResource Elevation2}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbX" Storyboard.TargetProperty="X"
                                                             To="16" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbX" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Effect" Value="{DynamicResource Elevation2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TreeCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="28" Height="18" VerticalAlignment="Center">
                                <Border x:Name="track" CornerRadius="9" Background="{DynamicResource GlassInnerDeepBg}"
                                        BorderBrush="{DynamicResource GlassInnerBorderBrush}" BorderThickness="1"/>
                                <Border x:Name="thumb" Width="14" Height="14" CornerRadius="7" Background="White"
                                        HorizontalAlignment="Left" Margin="2,0,0,0" Effect="{DynamicResource Elevation1}">
                                    <Border.RenderTransform><TranslateTransform x:Name="thumbX" X="0"/></Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <!-- 三态：目录部分勾选时显示中间态（不做位移动画，避免半选也在滑） -->
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource GlassAccentSoft}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbX" Storyboard.TargetProperty="X"
                                                             To="10" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbX" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ 层级积木：InnerSurface（卡片内凹面）/ StatusSurface（状态卡片） ══════════ -->
        <Style x:Key="GlassInnerSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassInnerBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassInnerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusInner}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="GlassStatusSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassNeutralSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBevelBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
<!-- ══════════ 数据列表项（Elevation1→2）：透明行 → Hover 亮面浮起 → Selected 强调玻璃 ══════════ -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="0"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource RadiusItem}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="hoverLight" CornerRadius="{DynamicResource RadiusItem}"
                                        Background="White" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassItemHoverBg}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation1}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="-1"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="hoverLight" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassItemSelectedBg}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassAccentText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ 树（内容目录）：现代细箭头＋120~180ms 旋转；行级 Hover/Selected 玻璃面 ══════════ -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource RadiusItem}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="expander" Grid.Column="0" Focusable="False" ClickMode="Press"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent" Width="16" Height="16">
                                                    <Path x:Name="arrow" Data="M 0,0 L 4.2,4.2 L 0,8.4"
                                                          Stroke="{DynamicResource GlassSubTextBrush}" StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform><RotateTransform x:Name="rot" Angle="0"/></Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource GlassAccentBrush}"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="rot" Storyboard.TargetProperty="Angle"
                                                                                     To="90" Duration="0:0:0.16"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="rot" Storyboard.TargetProperty="Angle"
                                                                                     To="0" Duration="0:0:0.16"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource GlassAccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassItemHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassItemSelectedBg}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ 数据表格（对象明细 / 报错清单共用）：无网格线，行＝悬浮数据条目 ══════════ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassSubTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusItem}"
                                Padding="{TemplateBinding Padding}" Margin="0,0,4,2" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassItemHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusItem}" Margin="0,1,0,1" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="hoverLight" CornerRadius="{DynamicResource RadiusItem}"
                                        Background="White" Opacity="0" IsHitTestVisible="False"/>
                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hoverLight" Property="Opacity" Value="0.16"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation1}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassItemSelectedBg}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Elevation2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTitleBrush}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource GlassAccentText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 报错清单专用行：淡红玻璃，Hover 红色增强（选中态仍走 Accent 玻璃） -->
        <Style x:Key="ErrorDataGridRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="{DynamicResource GlassErrorSurfaceSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassErrorText}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GlassErrorHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 顶栏 -->
            <RowDefinition Height="*"/>      <!-- 步骤导轨 + 页面 -->
            <RowDefinition Height="Auto"/>   <!-- 底部状态栏 -->
        </Grid.RowDefinitions>
        <!-- 白洗层：系统亚克力自带深色 tint，垫一层半透明白保证可读、又保留 30% 实时模糊 -->
        <Border Grid.RowSpan="3" Background="{StaticResource GlassWashBg}" IsHitTestVisible="False"/>
        <!-- 苹果风底景：内置柔色块光晕（mockup 的壁纸透色感，自绘、不依赖 OS 模糊） -->
        <Canvas Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="900" Height="700" Canvas.Left="-260" Canvas.Top="330" Opacity="0.32">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AmbientRose}" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="800" Height="800" Canvas.Left="780" Canvas.Top="120" Opacity="0.30">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AmbientAmber}" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="700" Height="500" Canvas.Left="180" Canvas.Top="-180" Opacity="0.28">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AmbientSky}" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- ══════════ 顶栏：标题 + 源→目标 ═══════════ -->
        <Border Grid.Row="0" Margin="14,14,14,0" Background="{StaticResource GlassRailBg}" CornerRadius="{StaticResource RadiusPanel}" Effect="{StaticResource Elevation2}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 应用图标（多尺寸 ico 里的 64px 图）：以前这里是个纯蓝方块，里面的字形丢了 -->
                    <Image Source="/PCMig;component/Assets/pcmig-64.png" Width="34" Height="34"
                           VerticalAlignment="Center" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           ToolTip="PCMig 迁移工具 · 郑子轩 个人制作"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PCMig 迁移工具" Style="{StaticResource CardTitle}" FontSize="15"/>
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="{Binding VersionText, Mode=OneWay}"/>
                            <Run Text=" · 旧电脑 → 新电脑 数据迁移"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- 更新日志入口：点开看历代版本改了什么（内容随程序内置） -->
                    <Button x:Name="BtnChangelog" Content="更新日志" Click="Changelog_Click"
                            Background="{DynamicResource GlassInfoSurface}" BorderBrush="{DynamicResource GlassInfoEdge}" BorderThickness="1" Foreground="{DynamicResource GlassInfoText}"
                            Padding="10,5" Margin="12,0,0,0" Cursor="Hand" FontSize="11.5"
                            VerticalAlignment="Center" ToolTip="查看从 v0.1.0 起的所有版本更新内容（安装目录下也有 更新日志.txt）"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource GlassNeutralSurface}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusItem}" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="源" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SourceSummary}" Margin="6,0,0,0" Foreground="{DynamicResource GlassTitleBrush}"
                                       MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="→" Margin="8,0" Foreground="{DynamicResource GlassFaintTextBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource GlassNeutralSurface}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusItem}" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="目标" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TargetSummary}" Margin="6,0,0,0" Foreground="{DynamicResource GlassTitleBrush}"
                                       MaxWidth="270" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ 主体：左侧导轨 + 页面 ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="14,12,0,0" Background="{StaticResource GlassRailBg}" CornerRadius="{StaticResource RadiusPanel}" Effect="{StaticResource Elevation2}">
              <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox Grid.Row="0" x:Name="StepRailList" Style="{StaticResource StepRail}" ItemsSource="{Binding StepItems}"
                         SelectedIndex="{Binding CurrentStep, Mode=OneWay}"
                         SelectionChanged="StepRail_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource GlassAccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource GlassTitleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource GlassAccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- 提示面板：原来挤在进度条下方，移到这里独立成块；清单可滚轮翻页。底栏不再重复显示状态文字 -->
                <Border Grid.Row="1" Background="{DynamicResource GlassErrorSurface}" BorderBrush="{DynamicResource GlassErrorEdge}" BorderThickness="0" CornerRadius="{DynamicResource RadiusCard}" Padding="12,10">
                    <!-- v0.3.8（缺陷 3）：有对象失败时整块变红（底色/边线/标题），不再是"失败了却像还在跑" -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource GlassErrorSurface}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource GlassErrorEdge}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasObjectFailures}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource GlassErrorSurfaceSoft}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource GlassErrorEdge}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding ErrorHeader}" Margin="16,0,14,5"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GlassErrorText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource GlassErrorText}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasObjectFailures}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource GlassErrorText}"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" MaxHeight="132" VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Disabled" Margin="16,0,14,4">
                            <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" LineHeight="15" Foreground="{DynamicResource GlassErrorText}" TextWrapping="Wrap"
                                   ToolTip="{Binding StatusMessage}"/>
                        </ScrollViewer>
                        <Grid Grid.Row="2">
                            <TextBlock Text="✔ 暂无报错" Margin="16,2,14,0" FontSize="11" Foreground="{DynamicResource GlassSuccessText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 滚轮必须用像素滚动：单条报错可能很高（长原因换行），
                                 默认的按项滚动遇到"只有一个超高项"时会一格都动不了（用户实测反馈） -->
                            <ListBox ItemsSource="{Binding FailItems}" MaxHeight="170" Margin="8,0,8,0"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <!-- 去掉 WPF 默认的蓝色悬停/选中高亮：那会让深色报错文字落在浅蓝底上，越看越糊 -->
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,2,4,3">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassErrorHoverBg}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassErrorHoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasErrors}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 行内不要 ToolTip：悬停弹出的提示窗会盖住列表并吞掉滚轮事件（实测"滚不动"的原因之一），
                                             路径本来就已完整显示在行首 -->
                                        <StackPanel Margin="0,3">
                                            <!-- 对象级失败（IsObjectLevel=true）整行红色加粗：一眼能看出"哪个对象死了、退出码什么意思" -->
                                            <TextBlock Text="{Binding Location}" FontSize="10.5" FontFamily="Consolas"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource GlassErrorText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsObjectLevel}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource GlassErrorText}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="FontSize" Value="11.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Reason}" FontSize="10.5" TextWrapping="Wrap" Margin="0,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource GlassWarnText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsObjectLevel}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource GlassErrorText}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 署名/品牌标签：常驻左下角，不占操作区 -->
                <TextBlock Grid.Row="2" Margin="18,10,14,16" FontSize="11" LineHeight="16"
                           Foreground="{DynamicResource GlassFaintTextBrush}" TextWrapping="Wrap"
                           ToolTip="https://github.com/Axuanbest"
                           Text="由 郑子轩 个人制作"/>
              </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="12,12,14,0">

                <!-- ══════ ① 连接源电脑 ══════ -->
                <Grid x:Name="PageConnect" Visibility="{Binding IsStepConnect, Converter={StaticResource BoolVis}}" Style="{StaticResource PageFade}">
        <Grid.Resources>
            <StaticResource x:Key="GlassCardBg" ResourceKey="GlassCardBlue"/>
        </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="2,0,0,10">
                        <TextBlock Text="① 连接旧电脑" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource PageSub}" Text="填旧电脑的 IP/电脑名与账号，点右侧按钮建立连接并列出可迁移的共享。"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP 或电脑名" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Height="30"
                                     Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="旧电脑的 IP 或主机名，如 192.168.1.50；也可直接粘贴 \\IP\共享名"/>
                            <Button Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" Content="连接并列出共享"
                                    Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="12,0,0,0"
                                    Command="{Binding ConnectCommand}" CommandParameter="{Binding ElementName=PwdBox}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="用户名" Style="{StaticResource FieldLabel}" Margin="0,8,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Height="30" Margin="0,8,0,0"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="旧电脑账号，如 域名\账号 或 电脑名\Administrator；留空用当前 Windows 凭据"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="密码" Style="{StaticResource FieldLabel}" Margin="12,8,8,0"/>
                            <PasswordBox Grid.Row="1" Grid.Column="3" x:Name="PwdBox" Height="30" Margin="0,8,0,0"
                                         ToolTip="留空则尝试当前 Windows 凭据（会话缓存约 15 分钟有效）"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,10,0,0"
                                      Content="连接时测速（向旧电脑写读 64MB 测试文件，建立正常速度基准）"
                                      IsChecked="{Binding BenchmarkOnConnect}"
                                      ToolTip="基准结果写进报告。正式迁移明显慢于基准时，优先怀疑安全软件实时扫描"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="可用共享" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Text="勾选即选中整盘；展开左侧目录可精确到文件夹/文件。"/>
                                <TextBox Grid.Column="2" Width="150" Height="28" VerticalAlignment="Center"
                                         Text="{Binding ManualShareName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="对方列不出共享时手动输入共享名——资源管理器地址栏 \\IP\ 后面那个名字（如 d、D$、Users）"/>
                                <Button Grid.Column="3" Content="＋ 添加共享" Style="{StaticResource NormalButton}"
                                        Margin="8,0,0,0" Height="28" Padding="12,0"
                                        Command="{Binding AddManualShareCommand}" CommandParameter="{Binding ElementName=PwdBox}"/>
                            </Grid>
                            <Border Grid.Row="2" Style="{StaticResource GlassInnerSurface}" Margin="0,10,0,0" Padding="0">
                            <ListBox ItemsSource="{Binding Shares}" BorderThickness="0" Margin="5,4"
                                     Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,3">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UncPath}" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource GlassTitleBrush}"/>
                                            <TextBlock Text="{Binding TypeText}" Margin="10,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Remark}" Margin="10,0,0,0" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Border>
                        </Grid>
                    </Border>

                    <Button Grid.Row="3" Content="下一步：选择要迁移的内容 →" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Margin="0,12,0,0" Padding="18,8"
                            Command="{Binding GoStepCommand}" CommandParameter="1"/>
                </Grid>

                <!-- ═════ ② 选择数据与目标 ═════ -->
                <Grid x:Name="PageSelect" Visibility="{Binding IsStepSelect, Converter={StaticResource BoolVis}}" Style="{StaticResource PageFade}">
        <Grid.Resources>
            <StaticResource x:Key="GlassCardBg" ResourceKey="GlassCardGreen"/>
        </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="2,0,0,10">
                        <TextBlock Text="② 选择要迁移的内容" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource PageSub}" Text="展开目录精确勾选，或勾选整个共享；右侧设定新电脑上的存放位置与线程数。"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="392"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="内容目录" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Objects.Count, StringFormat=已规划对象 {0} 个}"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                </Grid>
                                <CheckBox Grid.Row="1" Margin="0,8,0,0" Content="超大数据模式（上亿文件 / 几十 TB：改用排除规则，不展开目录）"
                                          IsChecked="{Binding ExpertMode}"
                                          ToolTip="目录树替换为「共享勾选 + 排除规则」，避免展开目录卡死"/>
                                <Border Grid.Row="2" Style="{StaticResource GlassInnerSurface}" Margin="0,8,0,0" Padding="4,3"
                                        Visibility="{Binding ExpertMode, Converter={StaticResource InvBoolVis}}">
                                <TreeView ItemsSource="{Binding DirTree}" BorderThickness="0"
                                          Background="Transparent"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ToolTip="勾共享=整盘；点 ▶ 展开可精确勾选目录/文件">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type local:DirNode}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Style="{StaticResource TreeCheckBox}" IsChecked="{Binding IsChecked, Mode=OneWay}" IsThreeState="True"
                                                          VerticalAlignment="Center"
                                                          PreviewMouseLeftButtonDown="NodeCheck_Toggle" PreviewKeyDown="NodeCheck_KeyToggle"/>
                                                <TextBlock Text="{Binding Name}" Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type local:FileRow}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Style="{StaticResource TreeCheckBox}" IsChecked="{Binding IsChecked, Mode=OneWay}" VerticalAlignment="Center"
                                                          PreviewMouseLeftButtonDown="NodeCheck_Toggle" PreviewKeyDown="NodeCheck_KeyToggle"/>
                                                <TextBlock Text="{Binding Name}" Margin="5,0,0,0"/>
                                                <TextBlock Text="{Binding SizeText}" Margin="8,0,0,0" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                            <EventSetter Event="TreeViewItem.Expanded" Handler="DirNode_Expanded"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                                </Border>

                                <Grid Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding ExpertMode, Converter={StaticResource BoolVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto" MaxHeight="160"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="勾选要迁移的共享（整盘）：" Style="{StaticResource FieldLabel}"/>
                                    <Border Grid.Row="1" Style="{StaticResource GlassInnerSurface}" Margin="0,4,0,6" Padding="4,3">
                                    <ListBox ItemsSource="{Binding Shares}" BorderThickness="0"
                                             Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UncPath}" Margin="6,0,0,0"/>
                                                    <TextBlock Text="{Binding TypeText}" Margin="8,0,0,0" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="排除规则（每行一条）：" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="3" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"
                                             Text="{Binding ExpertExclusions, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="4" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="语法：/XD 目录名或路径；/XF 文件名或通配符；裸词按目录处理；# 开头为注释。例：/XD node_modules　/XF *.tmp。规则与扫描、传输、验证同口径生效，并随任务存档。"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="存放位置（新电脑）" Style="{StaticResource CardTitle}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Height="30" Text="{Binding TargetRoot, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="新电脑上接收数据的位置，例如 D:\Migrated 或 D:\"/>
                                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource NormalButton}"
                                                Margin="8,0,0,0" Height="30" Padding="12,0"
                                                Command="{Binding BrowseTargetCommand}"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="线程数" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" Height="30" ItemsSource="{Binding MtOptions}" SelectedItem="{Binding SelectedMt}"
                                                  ToolTip="robocopy /MT 线程数。海量小文件调高更快；机械硬盘或网络较差建议 8/16。存入任务，续传沿用。"/>
                                        <TextBlock Grid.Column="2" Text="已有任务" Style="{StaticResource FieldLabel}" Margin="12,0,8,0"/>
                                        <ComboBox Grid.Column="3" Height="30" ItemsSource="{Binding ExistingJobs}"
                                                  SelectedItem="{Binding SelectedExistingJob}" DisplayMemberPath="DisplayText"
                                                  ToolTip="可恢复之前未完成的任务"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="执行" Style="{StaticResource CardTitle}"/>
                                    <Button Content="预检并生成计划" Style="{StaticResource NormalButton}" Margin="0,10,0,0"
                                            Padding="14,8" HorizontalAlignment="Stretch"
                                            Command="{Binding PrepareCommand}" CommandParameter="{Binding ElementName=PwdBox}"
                                            ToolTip="检查源可达性、磁盘空间、排除策略，生成迁移计划（不复制数据）"/>
                                    <Button Content="▶ 开始迁移" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                            Padding="14,9" HorizontalAlignment="Stretch"
                                            Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="⏸ 暂停" Style="{StaticResource NormalButton}" Margin="0,0,8,8"
                                                Padding="12,6" Command="{Binding PauseCommand}" IsEnabled="{Binding IsRunning}"
                                                ToolTip="当前对象传完后停止，可续传"/>
                                        <Button Content="⏹ 立即停止" Style="{StaticResource NormalButton}" Margin="0,0,8,8"
                                                Padding="12,6" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"
                                                ToolTip="终止当前 robocopy，已传部分保留，可续传"/>
                                        <Button Content="↻ 恢复任务" Style="{StaticResource NormalButton}" Margin="0,0,8,8"
                                                Padding="12,6" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="连接与安全提示" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="· 凭据仅用于本次会话，不写入任务文件。&#x0a;· 旧电脑空闲时 SMB 会话会自动断开，恢复任务前请确认源共享仍然可访问。&#x0a;· 整盘迁移完成后，目标根目录若被源盘根属性标成隐藏，工具会自动解除，并可用「打开目标文件夹」直接查看。"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ══════ ③ 迁移进度 ══════ -->
                <Grid x:Name="PageTransfer" Visibility="{Binding IsStepTransfer, Converter={StaticResource BoolVis}}" Style="{StaticResource PageFade}">
        <Grid.Resources>
            <StaticResource x:Key="GlassCardBg" ResourceKey="GlassCardPink"/>
        </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="2,0,0,10">
                        <TextBlock Text="③ 迁移进度" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource PageSub}" Text="实时进度、速度、剩余时间与文件流；失败位置与原因也在这里，处理完点「恢复任务」补齐。"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0" MinWidth="118" Visibility="{Binding MigrationProgressVisibility}">
                                <TextBlock Text="{Binding Percent, StringFormat={}{0:F1}%}" FontSize="42" FontWeight="Bold"
                                           Foreground="{DynamicResource GlassAccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="总体进度" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ProgressBar Style="{StaticResource BigProgress}" Value="{Binding Percent}" Visibility="{Binding MigrationProgressVisibility}"/>
                                <!-- 「尝试修复」独立进度：只在修复期间出现，避免与迁移进度混淆 -->
                                <Border Visibility="{Binding RepairVisibility}" Margin="0,10,0,0"
                                        Background="{DynamicResource GlassInfoSurface}" BorderBrush="{DynamicResource GlassInfoEdge}" BorderThickness="1" CornerRadius="{DynamicResource RadiusItem}" Padding="12,9">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="正在修复（从源共享重拷差异文件）" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassInfoText}"/>
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding RepairObjectText}" FontSize="12" Foreground="{DynamicResource GlassSubTextBrush}"/>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding RepairPercent}" Margin="0,7,0,0"/>
                                        <TextBlock Text="{Binding RepairText}" FontSize="11.5" Foreground="{DynamicResource GlassSubTextBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CurrentFileText}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource GlassSuccessText}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CurrentFileText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TargetSummary}" FontWeight="SemiBold" Foreground="{DynamicResource GlassSubTextBrush}"
                                               MaxWidth="340" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetSummary}"/>
                                </Grid>
                                <!-- v0.3.8（缺陷 3）：当前对象 + 停滞提示。生产事故里"界面长时间不动"是用户判断卡死并手动终止的直接原因，
                                     这一行明确写出"当前在传哪个对象、这个对象已传多少"，并在停滞/大文件场景解释"为什么数字不动"。 -->
                                <TextBlock Text="{Binding CurrentObjectDetail}" Margin="0,7,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource GlassTitleBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentObjectDetail}"
                                           Visibility="{Binding HasCurrentObjectDetail, Converter={StaticResource BoolVis}}"/>
                                <Border Visibility="{Binding HasStallHint, Converter={StaticResource BoolVis}}"
                                        Background="{DynamicResource GlassWarnSurface}" BorderBrush="{DynamicResource GlassWarnEdge}" BorderThickness="1"
                                        CornerRadius="6" Padding="9,6" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding StallHintText}" FontSize="11.5" Foreground="{DynamicResource GlassWarnText}"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="{Binding BalanceText}" Margin="0,8,0,0" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding BalanceText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GlassSuccessText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasShortfall}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource GlassWarnText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="传输速度（网卡实时）" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding NicSpeedText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GlassTitleBrush}" Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="任务实测（本次平均）" FontSize="12" Foreground="{DynamicResource GlassSubTextBrush}"/>
                                    <TextBlock Text="{Binding EngineSpeedText}" FontSize="12" Foreground="{DynamicResource GlassSubTextBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="预计剩余（按任务实测）" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding EtaText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GlassTitleBrush}" Margin="0,3,0,0"
                                           ToolTip="按本次任务自己的实测速率（已落盘字节 ÷ 用时）估算剩余时间，与网卡实时吞吐无关"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="对象进度" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding ObjectText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GlassTitleBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DataLabel}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding ActualBytesText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource GlassTitleBrush}"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="计划" FontSize="12" Foreground="{DynamicResource GlassSubTextBrush}"/>
                                    <TextBlock Text="{Binding PlanBytesText}" FontSize="12" Foreground="{DynamicResource GlassSubTextBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="330"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*" MinWidth="250"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="对象明细" Style="{StaticResource CardTitle}"/>
                                <Border Grid.Row="1" Style="{StaticResource GlassInnerSurface}" Margin="0,8,0,0" Padding="4,2">
                                <DataGrid ItemsSource="{Binding Objects}" IsReadOnly="True"
                                          AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0"
                                          Background="Transparent"
                                          RowBackground="Transparent" AlternatingRowBackground="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="对象" Binding="{Binding ObjectId}" Width="100"/>
                                        <DataGridTextColumn Header="源" Binding="{Binding SourcePath}" Width="*"/>
                                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="正在复制的文件" Style="{StaticResource CardTitle}"/>
                                <Border Grid.Row="1" Style="{StaticResource GlassInnerSurface}" Margin="0,8,0,0" Padding="4,3">
                                <ListBox x:Name="LiveFilesList" ItemsSource="{Binding LiveFiles}"
                                         BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11"
                                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="7,3"/>
                                            <Setter Property="Margin" Value="0,1,0,1"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ═════ ④ 结果与校验 ══════ -->
                <Grid x:Name="PageResult" Visibility="{Binding IsStepResult, Converter={StaticResource BoolVis}}" Style="{StaticResource PageFade}">
        <Grid.Resources>
            <StaticResource x:Key="GlassCardBg" ResourceKey="GlassCardPurple"/>
        </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="230"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="2,0,0,10">
                        <TextBlock Text="④ 结果与校验" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource PageSub}" Text="迁移完成后做完整性校验并出报告；失败的位置与原因都在这里。"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <WrapPanel>
                            <Button Content="✔ 验证完整性" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                    Command="{Binding VerifyCommand}" IsEnabled="{Binding HasJob}"
                                    ToolTip="源与目标逐对象比对文件数/字节数（L1），可按需做抽样哈希（L2）"/>
                            <Button Content="⚠ 尝试修复" Style="{StaticResource NormalButton}" Margin="0,0,8,0"
                                    Command="{Binding RepairCommand}" IsEnabled="{Binding CanRepair}"
                                    ToolTip="按验证结果把不一致/失败的对象从共享重新拉取、覆盖本地，随后自动重新校验并报出修复前后对比；不重传整个任务"/>
                            <CheckBox Content="强制覆盖" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12"
                                      IsChecked="{Binding RepairForceOverwrite}"
                                      ToolTip="勾选（默认）：先把目标侧同名文件删掉，再从共享重新拉取覆盖——内容坏掉但大小/时间没变的文件只有这样才能修回来（robocopy 的 /IS /IT 实测无效）。不勾选：只补缺失/大小不同的文件（更快，但内容坏了而大小没变的会被跳过）"/>
                            <Button Content="打开报告" Style="{StaticResource NormalButton}" Margin="0,0,10,0"
                                    Command="{Binding ReportCommand}" IsEnabled="{Binding HasJob}"/>
                            <Button Content="打开目标文件夹" Style="{StaticResource NormalButton}" Margin="0,0,10,0"
                                    Command="{Binding OpenTargetCommand}" IsEnabled="{Binding HasJob}"
                                    ToolTip="在资源管理器里打开迁移目标；若目标根被源盘根属性带成隐藏会自动解除"/>
                            <Button Content="↻ 恢复任务" Style="{StaticResource NormalButton}" Margin="0,0,10,0"
                                    Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠ 报错清单" Style="{StaticResource CardTitle}" Foreground="{DynamicResource GlassErrorText}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="失败的位置与原因；处理完（例如关掉旧电脑上占用文件的程序）点「恢复任务」即可补齐"/>
                            </StackPanel>
                            <Border Grid.Row="1" Style="{StaticResource GlassInnerSurface}" Margin="0,8,0,0" Padding="4,2">
                            <DataGrid ItemsSource="{Binding FailItems}" IsReadOnly="True"
                                      AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0"
                                      Background="Transparent"
                                      RowBackground="Transparent" AlternatingRowBackground="Transparent" RowStyle="{StaticResource ErrorDataGridRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="80"/>
                                    <DataGridTextColumn Header="位置（盘符\文件夹\文件）" Binding="{Binding Location}" Width="*"/>
                                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="320"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource Card}" Background="{DynamicResource GlassLogBg}" BorderBrush="{DynamicResource GlassLogBg}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="实时日志（完整日志见 %ProgramData%\PCMig\Logs 与任务目录）"
                                       Foreground="{DynamicResource GlassFaintTextBrush}" FontSize="11"/>
                            <TextBox Grid.Row="1" Margin="0,8,0,0" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11" BorderThickness="0"
                                     Background="{DynamicResource GlassLogBg}" Foreground="{DynamicResource GlassLogText}" CaretBrush="{DynamicResource GlassLogText}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════ 底部状态栏（常驻） ═══════════ -->
        <Border Grid.Row="2" Margin="14,12,14,14" Background="{StaticResource GlassRailBg}" CornerRadius="{StaticResource RadiusPanel}" Effect="{StaticResource Elevation2}" Padding="18,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" Style="{StaticResource SlimProgress}" Value="{Binding Percent}"/>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="188"/>
                        <ColumnDefinition Width="248"/>
                        <ColumnDefinition Width="152"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 百分比与数据量同一字号、同一颜色、固定列宽：数值跳动时不会左右漂移；
                         迁移页大号百分比已经显示同一个数字，这里隐藏（Hidden 保留占位，切页不跳动） -->
                    <TextBlock Text="{Binding Percent, StringFormat={}{0:F1}%}" FontSize="14" VerticalAlignment="Center"
                               Foreground="{StaticResource GlassAccentBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStepTransfer}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="13" Foreground="{DynamicResource GlassTitleBrush}" VerticalAlignment="Center"/>
                    <!-- 网速 = 真实网卡吞吐（任务管理器同源）+ 60 秒时间轴波形；占用与原文字一致，不额外加高 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                ToolTip="{Binding NicSparkTip}">
                        <TextBlock Text="⇅" FontSize="11" Foreground="{DynamicResource GlassFaintTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding NicSpeedText}" FontSize="13" Foreground="{DynamicResource GlassSubTextBrush}" VerticalAlignment="Center"
                                   MinWidth="76"/>
                        <Polyline Points="{Binding NicSparkPoints}" Width="116" Height="20" Margin="8,0,0,0"
                                  Stroke="{DynamicResource GlassAccentBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding EtaText}" FontSize="13" Foreground="{DynamicResource GlassSubTextBrush}" VerticalAlignment="Center"
                               ToolTip="预计剩余时间：按本次任务自己的实测速率（已落盘字节 ÷ 用时）估算，与上面的网卡实时吞吐无关"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                        <TextBlock Text="网络" FontSize="{StaticResource FontStatus}" Foreground="{StaticResource GlassSubTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource GlassSuccess}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="5">
                        <Button Content="▶ 开始迁移" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,8,0"
                                Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
                        <Button Content=" 暂停" Style="{StaticResource NormalButton}" Padding="10,5" Margin="0,0,8,0"
                                Command="{Binding PauseCommand}" IsEnabled="{Binding IsRunning}"/>
                        <Button Content=" 停止" Style="{StaticResource NormalButton}" Padding="10,5" Margin="0,0,8,0"
                                Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
                        <Button Content="↻ 恢复" Style="{StaticResource NormalButton}" Padding="10,5"
                                Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
