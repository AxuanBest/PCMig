<Window x:Class="PCMig.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCMig.Gui"
        Title="PCMig 迁移工具 v0.2.5" Width="1240" Height="820"
        MinWidth="1020" MinHeight="700"
        Icon="/PCMig;component/Assets/pcmig.ico"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F5F6F8">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E3E8"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="NormalButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- 主区域：左右两块 -->
            <RowDefinition Height="Auto"/>  <!-- 底部通栏进度 -->
        </Grid.RowDefinitions>

        <!-- ═══════════ 主区域 ═══════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───── 左列：署名 / ① 连接 / ② 内容树 / ③ 目标与操作 ───── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 个人署名 -->
                <TextBlock Grid.Row="0" Margin="4,0,0,3" HorizontalAlignment="Left">
                    <Run Text="⚡ Axuanbest" FontWeight="Bold" Foreground="#2563EB"/>
                    <Run Text=" 个人制作" Foreground="#94A3B8" FontSize="10"/>
                </TextBlock>

                <!-- ① 源电脑连接 -->
                <GroupBox Grid.Row="1" Header="① 源电脑（旧电脑）连接" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="IP 或电脑名："/>
                        <TextBox Grid.Column="1" Grid.ColumnSpan="3" Height="28" VerticalAlignment="Center"
                                 Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="旧电脑的 IP 或主机名，如 192.168.1.50；也可直接粘贴 \\IP\共享名"/>
                        <Button Grid.Column="4" Grid.RowSpan="2" Content="连接并列出共享" Height="28" VerticalAlignment="Center"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConnectCommand}" CommandParameter="{Binding ElementName=PwdBox}"/>
                        <Label Grid.Row="1" Content="用户名："/>
                        <TextBox Grid.Row="1" Grid.Column="1" Height="28" VerticalAlignment="Center"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="旧电脑的管理员账号，如 OLD-PC\Administrator 或 域名\账号；留空则用当前 Windows 凭据"/>
                        <Label Grid.Row="1" Grid.Column="2" Content="密码："/>
                        <PasswordBox Grid.Row="1" Grid.Column="3" x:Name="PwdBox" Height="28" VerticalAlignment="Center"
                                     ToolTip="留空则尝试当前 Windows 凭据（会话缓存约 15 分钟有效）"/>
                    </Grid>
                </GroupBox>

                <!-- ② 选择要迁移的内容：目录树 / 超大数据模式（排除规则） -->
                <GroupBox Grid.Row="2" Style="{StaticResource GroupBoxStyle}">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="② 选择要迁移的内容"/>
                            <CheckBox Content="超大数据模式" IsChecked="{Binding ExpertMode}"
                                      Margin="14,0,0,0" VerticalAlignment="Center"
                                      ToolTip="上亿文件 / 几十 TB 的服务器级迁移：目录树替换为排除规则输入，无需展开目录"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <!-- 普通模式：级联三态目录树 -->
                        <TreeView ItemsSource="{Binding DirTree}" BorderThickness="0"
                                  Visibility="{Binding ExpertMode, Converter={StaticResource InvBoolVis}}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ToolTip="勾共享=整盘；点 ▶ 展开可精确勾选目录/文件">
                            <TreeView.Resources>
                                <!-- 目录 / 共享根节点：三态级联（点击由 code-behind 统一接管，绕过 WPF 默认三态循环） -->
                                <HierarchicalDataTemplate DataType="{x:Type local:DirNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" IsThreeState="True"
                                                  VerticalAlignment="Center"
                                                  PreviewMouseLeftButtonDown="NodeCheck_Toggle" PreviewKeyDown="NodeCheck_KeyToggle"/>
                                        <TextBlock Text="{Binding Name}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <!-- 文件叶子节点 -->
                                <DataTemplate DataType="{x:Type local:FileRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" VerticalAlignment="Center"
                                                  PreviewMouseLeftButtonDown="NodeCheck_Toggle" PreviewKeyDown="NodeCheck_KeyToggle"/>
                                        <TextBlock Text="{Binding Name}" Margin="4,0,0,0"/>
                                        <TextBlock Text="{Binding SizeText}" Margin="8,0,0,0" Foreground="#9CA3AF" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <EventSetter Event="TreeViewItem.Expanded" Handler="DirNode_Expanded"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>

                        <!-- 超大数据模式：共享勾选 + 排除规则 -->
                        <Grid Visibility="{Binding ExpertMode, Converter={StaticResource BoolVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MaxHeight="150"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="勾选要迁移的共享（整盘）："/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Shares}" BorderThickness="0"
                                     Margin="0,2,0,4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UncPath}" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding TypeText}" Margin="8,0,0,0" Foreground="#9CA3AF" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="2" Text="排除规则（每行一条）："/>
                            <TextBox Grid.Row="3" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"
                                     Text="{Binding ExpertExclusions, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="4" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="语法：/XD 目录名或路径；/XF 文件名或通配符；裸词按目录处理；# 开头为注释。例：/XD node_modules　/XF *.tmp　/XF *.iso。规则与扫描、传输、验证同口径生效，并随任务存档。"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- ③ 目标与操作 -->
                <GroupBox Grid.Row="3" Header="③ 目标与操作" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="目标路径："/>
                            <TextBox Grid.Column="1" Height="28" VerticalAlignment="Center"
                                     Text="{Binding TargetRoot, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="新电脑上接收数据的位置，例如 D:\Migrated 或 D:\"/>
                            <Button Grid.Column="2" Content="浏览…" Height="28" VerticalAlignment="Center"
                                    Style="{StaticResource NormalButton}" Command="{Binding BrowseTargetCommand}"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="已有任务："/>
                            <ComboBox Grid.Column="1" Height="28" VerticalAlignment="Center"
                                      ItemsSource="{Binding ExistingJobs}" SelectedItem="{Binding SelectedExistingJob}"
                                      DisplayMemberPath="DisplayText" ToolTip="可恢复之前未完成的任务"/>
                            <Label Grid.Column="2" Content="线程数："/>
                            <ComboBox Grid.Column="3" Width="76" Height="28" VerticalAlignment="Center"
                                      ItemsSource="{Binding MtOptions}" SelectedItem="{Binding SelectedMt}"
                                      ToolTip="robocopy /MT 多线程数。海量小文件或大文件多时调高（64/128）更快；机械硬盘或网络较差建议 8/16。存入任务，续传沿用。"/>
                        </Grid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="预检并生成计划" Style="{StaticResource NormalButton}"
                                    Command="{Binding PrepareCommand}" CommandParameter="{Binding ElementName=PwdBox}"/>
                            <Button Content="▶ 开始迁移" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
                            <Button Content="⏸ 暂停" Style="{StaticResource NormalButton}"
                                    Command="{Binding PauseCommand}" IsEnabled="{Binding IsRunning}"
                                    ToolTip="当前对象传完后停止，可续传"/>
                            <Button Content="⏹ 立即停止" Style="{StaticResource NormalButton}"
                                    Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"
                                    ToolTip="终止当前 robocopy，已传部分保留，可续传"/>
                            <Button Content="↻ 恢复任务" Style="{StaticResource NormalButton}"
                                    Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}"/>
                            <Button Content="✔ 验证" Style="{StaticResource NormalButton}"
                                    Command="{Binding VerifyCommand}" IsEnabled="{Binding HasJob}"/>
                            <Button Content="📄 打开报告" Style="{StaticResource NormalButton}"
                                    Command="{Binding ReportCommand}" IsEnabled="{Binding HasJob}"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E0E3E8"/>

            <!-- ───── 右列：对象明细 / 实时文件流 / 实时日志 / 报错 ───── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="27*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="19*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="27*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="27*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="对象明细" Style="{StaticResource GroupBoxStyle}">
                    <DataGrid ItemsSource="{Binding Objects}" IsReadOnly="True" AutoGenerateColumns="False"
                              HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="对象" Binding="{Binding ObjectId}" Width="105"/>
                            <DataGridTextColumn Header="源" Binding="{Binding SourcePath}" Width="*"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#E0E3E8"/>

                <GroupBox Grid.Row="2" Header="实时文件流（正在复制的文件）" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding CurrentFileText}" Foreground="#0F766E" FontWeight="SemiBold"
                                   FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Margin="2,0,2,3" ToolTip="{Binding CurrentFileText}"/>
                        <ListBox x:Name="LiveFilesList" Grid.Row="1" ItemsSource="{Binding LiveFiles}"
                                 BorderThickness="0" Background="#FAFAFA" FontFamily="Consolas" FontSize="11"
                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2,0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </GroupBox>
                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#E0E3E8"/>

                <GroupBox Grid.Row="4" Header="实时日志（完整日志见 %ProgramData%\PCMig\Logs 与 Job 目录）"
                          Style="{StaticResource GroupBoxStyle}">
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="#FAFAFA"/>
                </GroupBox>
                <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch" Background="#E0E3E8"/>

                <GroupBox Grid.Row="6" Header="⚠ 报错（失败的位置与原因，处理完点「恢复任务」即可补齐）"
                          Style="{StaticResource GroupBoxStyle}" Foreground="#B91C1C">
                    <DataGrid ItemsSource="{Binding FailItems}" IsReadOnly="True" AutoGenerateColumns="False"
                              HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal"
                              Foreground="#374151">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="70"/>
                            <DataGridTextColumn Header="位置（盘符\文件夹\文件）" Binding="{Binding Location}" Width="*"/>
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- ═══════════ 底部通栏进度条 ═══════════ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E3E8" BorderThickness="0,1,0,0"
                Margin="2,4,2,2" Padding="12,8">
            <StackPanel>
                <!-- 进度条 + 运行时光波（一道光带把进度往前推的动效，仅运行时可见） -->
                <Grid x:Name="WaveHost" Height="20" ClipToBounds="True">
                    <ProgressBar Height="20" Minimum="0" Maximum="100" Value="{Binding Percent}"/>
                    <Rectangle x:Name="WaveRect" Width="110" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="WaveSlide" X="-120"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding SpeedText}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding EtaText}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ObjectText}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#2563EB" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
