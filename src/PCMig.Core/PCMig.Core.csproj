<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.3</Version>
    <InformationalVersion>0.5.3</InformationalVersion>
    <Description>PCMig 核心引擎：Preflight / Scan / Plan / Transfer / Verify / Report</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PCMig.Core.Tests" />
    <!-- D3 起：诊断测试要直接覆盖诊断观察点用到的 internal 纯函数（例如检查名→checkCode 的稳定映射）。 -->
    <InternalsVisibleTo Include="PCMig.Diagnostics.Tests" />
  </ItemGroup>

  <!-- 诊断契约层：只依赖它（不认识诊断运行时，也不认识任何 UI 技术栈）。 -->
  <ItemGroup>
    <ProjectReference Include="..\PCMig.Diagnostics.Abstractions\PCMig.Diagnostics.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>




